#!/usr/bin/env python3
"""Patch keys in a pacenote.yml in place and print what changed as JSON.

Usage: config-set --file PATH key=value [key=value ...]
       config-set --file PATH --add|--remove key=value [key=value ...]

Keys are `top` or `section.key`. Values are written in the documented form: true, false,
integers and [a-z_]+ words bare, anything else double-quoted. Indentation, comments, order
and unknown keys survive. All-or-nothing: every key is checked before anything is written.
Refuses list keys, unknown keys, duplicate keys and malformed lines.
--add appends each value as a `- item` of a list key (skipped when already there) and
--remove deletes it; scalar keys are refused. Under `layers` a missing key is created,
so `--add layers.frontend=<path>` opens a new layer. A scalar `section.key` that the default
in skills/_shared/pacenote-yml.md documents but the file lacks (a file from before the key) is
first inserted at the end of its section, copied with its comment lines from the default,
then set; a key the default does not document is still refused. Exit 1 with a one-line message on any
refusal. Stdlib only.
"""
import json
import os
import re
import sys

LINE = re.compile(r"^(\s*)([A-Za-z_][\w]*):(\s*)(.*?)(\s*#.*)?$")
BARE = re.compile(r"^(true|false|-?\d+|[a-z_]+)$")
LIST_KEYS = {"skills.allowlist"}
OPEN_SECTIONS = {"layers"}  # sections whose keys are names chosen by the user
ITEM = re.compile(r"^(\s*)-\s+(.*?)\s*$")
REFERENCE = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                         "skills", "_shared", "pacenote-yml.md")


def fail(msg):
    print("pacenote: %s" % msg, file=sys.stderr)
    return 1


def index(lines):
    """Map `top` / `section.key` -> line number; report duplicates and unparsable lines."""
    found, dups, bad = {}, [], []
    section = None
    for n, raw in enumerate(lines):
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if raw.lstrip().startswith("- "):
            continue
        m = LINE.match(raw.rstrip("\n"))
        if not m:
            bad.append(n + 1)
            continue
        indent, key = len(m.group(1)), m.group(2)
        if indent == 0:
            section = key
            name = key
        elif section:
            name = "%s.%s" % (section, key)
        else:
            bad.append(n + 1)
            continue
        if name in found:
            dups.append(name)
        found[name] = n
    return found, dups, bad


def is_list(lines, n):
    m = LINE.match(lines[n].rstrip("\n"))
    value = m.group(4)
    if value.startswith("["):
        return True
    for nxt in lines[n + 1:]:
        if not nxt.strip() or nxt.lstrip().startswith("#"):
            continue
        return nxt.lstrip().startswith("- ")
    return False


def items(lines, n):
    """Return [(line number, value)] of the `- item` lines under the key on line n."""
    out = []
    for j in range(n + 1, len(lines)):
        raw = lines[j]
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        m = ITEM.match(raw.rstrip("\n"))
        if not m:
            break
        out.append((j, m.group(2).strip('"')))
    return out


def section_end(lines, start):
    """Line index after the last non-blank line of the top-level section opened on `start`."""
    last = start
    for j in range(start + 1, len(lines)):
        raw = lines[j]
        if raw.strip() and not raw[0].isspace():
            break
        if raw.strip():
            last = j
    return last + 1


def item_text(value):
    return value if re.match(r"^[\w./@~+-]+$", value) else '"%s"' % value


def patch_list(path, lines, found, pairs, remove):
    out = []
    for pair in pairs:
        if "=" not in pair:
            return fail("expected key=value, got %r" % pair)
        key, value = pair.split("=", 1)
        if not value or '"' in value or "\n" in value:
            return fail("value for %s must be non-empty, without a double quote or newline" % key)
        section = key.split(".", 1)[0]
        if key not in found:
            if remove or "." not in key or section not in OPEN_SECTIONS or section not in found \
                    or not re.match(r"^[A-Za-z_][\w]*$", key.split(".", 1)[1]):
                return fail("unknown list key %s in %s" % (key, path))
            at = section_end(lines, found[section])
            lines[at:at] = ["  %s:\n" % key.split(".", 1)[1]]
            found, _, _ = index(lines)
        n = found[key]
        m = LINE.match(lines[n].rstrip("\n"))
        if m.group(4) not in ("", "[]"):
            return fail("%s is a scalar key; use key=value without --add/--remove" % key)
        current = items(lines, n)
        values = [v for _, v in current]
        if remove:
            hits = [j for j, v in current if v == value]
            if not hits:
                out.append({"key": key, "removed": value, "changed": False})
                continue
            del lines[hits[0]]
            out.append({"key": key, "removed": value, "changed": True})
        else:
            if value in values:
                out.append({"key": key, "added": value, "changed": False})
                continue
            if m.group(4) == "[]":
                lines[n] = "%s%s:%s\n" % (m.group(1), m.group(2), m.group(5) and " " + m.group(5).strip() or "")
            at = (current[-1][0] if current else n) + 1
            lines[at:at] = ["%s  - %s\n" % (m.group(1), item_text(value))]
            out.append({"key": key, "added": value, "changed": True})
        found, _, _ = index(lines)
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(lines)
    print(json.dumps({"file": os.path.abspath(path), "lists": out}, indent=2))
    return 0


def render(value):
    if BARE.match(value):
        return value
    return '"%s"' % value


def main(argv):
    if "--help" in argv or "-h" in argv or not argv:
        print(__doc__.strip())
        return 0 if argv else 2
    if "--file" not in argv:
        return fail("--file PATH is required")
    i = argv.index("--file")
    if i + 1 >= len(argv):
        return fail("--file needs a path")
    path = argv[i + 1]
    remove = "--remove" in argv
    pairs = [a for j, a in enumerate(argv) if j not in (i, i + 1) and a not in ("--add", "--remove")]
    if not pairs:
        return fail("no key=value given")
    if not os.path.isfile(path):
        return fail("no such file: %s" % path)
    with open(path, encoding="utf-8") as f:
        lines = f.readlines()
    found, dups, bad = index(lines)
    if bad:
        return fail("cannot parse %s line %s" % (path, ", ".join(str(b) for b in bad)))
    if dups:
        return fail("duplicate key in %s: %s" % (path, ", ".join(sorted(set(dups)))))
    if "--add" in argv and remove:
        return fail("--add and --remove are separate calls")
    if "--add" in argv or remove:
        return patch_list(path, lines, found, pairs, remove)
    changes = []
    for pair in pairs:
        if "=" not in pair:
            return fail("expected key=value, got %r" % pair)
        key, value = pair.split("=", 1)
        if '"' in value or "\n" in value:
            return fail("value for %s may not contain a double quote or newline" % key)
        if key not in found:
            block = documented(key)
            section = key.split(".", 1)[0]
            if not block or section not in found:
                return fail("unknown key %s in %s" % (key, path))
            end = section_end(lines, found[section])
            lines[end:end] = block
            found, _, _ = index(lines)
            changes = [(k, found[k], LINE.match(lines[found[k]].rstrip("\n")), v)
                       for k, _, _, v in changes]
        n = found[key]
        if key in LIST_KEYS or is_list(lines, n):
            return fail("%s is a list key; edit it by hand" % key)
        m = LINE.match(lines[n].rstrip("\n"))
        if m.group(4) == "" and not m.group(3):
            return fail("%s has no scalar value on line %d" % (key, n + 1))
        changes.append((key, n, m, value))
    out = []
    for key, n, m, value in changes:
        old = m.group(4)
        new = render(value)
        gap = m.group(3) if old else " "
        comment = m.group(5) or ""
        if comment:
            column = len(m.group(1)) + len(m.group(2)) + 1 + len(m.group(3)) + len(old)
            shift = column + len(comment) - len(comment.lstrip())
            comment = " " * max(1, shift - column - (len(new) - len(old))) + comment.lstrip()
        lines[n] = "%s%s:%s%s%s\n" % (m.group(1), m.group(2), gap, new, comment)
        out.append({"key": key, "old": old, "new": new})
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(lines)
    print(json.dumps({"file": os.path.abspath(path), "changes": out}, indent=2))
    return 0


def documented(key):
    """The default's lines for scalar KEY (its line plus following comment lines), or None."""
    if "." not in key:
        return None
    try:
        with open(REFERENCE, encoding="utf-8") as f:
            blocks = re.findall(r"```yaml\n(.*?)```", f.read(), re.S)
    except OSError:
        return None
    if len(blocks) != 1:
        return None
    ref = blocks[0].splitlines(True)
    found, _, _ = index(ref)
    if key not in found or is_list(ref, found[key]):
        return None
    n = found[key]
    m = LINE.match(ref[n].rstrip("\n"))
    if m.group(4) == "":
        return None
    out = [ref[n]]
    for raw in ref[n + 1:]:
        if raw.strip().startswith("#") and raw.startswith(" "):
            out.append(raw)
        else:
            break
    return out


def section_end(lines, n):
    """Index after the last indented line of the section starting at line N."""
    end = n + 1
    for i in range(n + 1, len(lines)):
        if lines[i].startswith((" ", "\t")) and lines[i].strip():
            end = i + 1
        elif lines[i].strip():
            break
    return end


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
