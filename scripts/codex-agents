#!/usr/bin/env python3
"""Generate Codex custom agents (.codex/agents/<name>.toml) from agents/*.md.

Usage: codex-agents [--out DIR] [--check] [--agent NAME]

agents/*.md stay the source; the TOML is generated, never edited. Each file holds name,
description and developer_instructions (the markdown body). Codex has no per-agent tool
allowlist (DECISIONS 2026-11-19 M8), so the frontmatter `tools:` list becomes rules at
the top of the instructions: no Bash means `[features] shell_tool = false` and "never run
shell commands"; no Write or Edit means "never create, edit or delete files"; Write without
Edit means "create only the files your prompt names"; no WebSearch or WebFetch means "never
fetch from the network". maxTurns and tools have no Codex key and are dropped. No model is
set: the caller passes the role's model per dispatch.
--out DIR: where to write (default <plugin>/.codex/agents). --check: write nothing, exit 1
listing the files that are missing, stale or extra. --agent NAME: print one file to stdout.
Stdlib only.
"""
import glob
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_OUT = os.path.join(ROOT, ".codex", "agents")


def parse(path):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    end = text.find("\n---", 4)
    fm, body = text[4:end], text[end + 4:].lstrip("\n")
    data, key = {}, None
    for line in fm.splitlines():
        m = re.match(r"^([A-Za-z][\w-]*):\s*(.*)$", line)
        if m:
            key, value = m.group(1), m.group(2).strip()
            data[key] = "" if value in (">", "|", ">-", "|-") else value
        elif key and line.startswith(" "):
            data[key] = (data[key] + " " + line.strip()).strip()
    return data, body


def rules(tools):
    names = set(t for t in re.split(r"[,\s]+", tools) if t)
    has = lambda *ts: bool(names & set(ts))
    out = []
    if not has("Bash"):
        out.append("Never run shell commands.")
    if not has("Write", "Edit", "MultiEdit", "NotebookEdit"):
        out.append("Never create, edit or delete files.")
    elif not has("Edit", "MultiEdit"):
        out.append("Create only the files your prompt names; never edit or delete any other file.")
    if not has("WebSearch", "WebFetch"):
        out.append("Never fetch anything from the network.")
    return out, not has("Bash")


def toml_text(value):
    if "'''" not in value:
        return "'''\n" + value + "'''"
    return json.dumps(value, ensure_ascii=False)


def render(path):
    fm, body = parse(path)
    name = fm["name"]
    lines, no_shell = rules(fm.get("tools", ""))
    head = ("Codex gives this agent the parent's tools; pacenote's definition grants only: %s. "
            "Keep to them:\n" % fm.get("tools", "none")) + "".join("- %s\n" % l for l in lines)
    out = ["# Generated by scripts/codex-agents from agents/%s.md; do not edit." % name,
           "name = %s" % json.dumps(name),
           "description = %s" % json.dumps(fm.get("description", ""), ensure_ascii=False),
           "developer_instructions = %s" % toml_text(head + "\n" + body)]
    if no_shell:
        out += ["", "[features]", "shell_tool = false"]
    return name, "\n".join(out) + "\n"


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    out_dir = argv[argv.index("--out") + 1] if "--out" in argv else DEFAULT_OUT
    sources = sorted(glob.glob(os.path.join(ROOT, "agents", "*.md")))
    rendered = dict(render(p) for p in sources)
    if "--agent" in argv:
        name = argv[argv.index("--agent") + 1]
        if name not in rendered:
            print("codex-agents: no agents/%s.md" % name, file=sys.stderr)
            return 1
        sys.stdout.write(rendered[name])
        return 0
    if "--check" in argv:
        bad = []
        for name, text in rendered.items():
            path = os.path.join(out_dir, name + ".toml")
            try:
                with open(path, encoding="utf-8") as f:
                    if f.read() != text:
                        bad.append("stale %s" % path)
            except OSError:
                bad.append("missing %s" % path)
        for path in glob.glob(os.path.join(out_dir, "*.toml")):
            if os.path.splitext(os.path.basename(path))[0] not in rendered:
                bad.append("extra %s" % path)
        for b in bad:
            print("codex-agents: %s; run scripts/codex-agents" % b, file=sys.stderr)
        return 1 if bad else 0
    os.makedirs(out_dir, exist_ok=True)
    for name, text in rendered.items():
        with open(os.path.join(out_dir, name + ".toml"), "w", encoding="utf-8") as f:
            f.write(text)
    print(json.dumps({"written": sorted(rendered), "out": out_dir}, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
