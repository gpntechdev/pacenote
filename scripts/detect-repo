#!/usr/bin/env python3
"""Detect repository facts for /specd:init and /specd:onboard, printed as JSON.

Usage: detect-repo [--from DIR]

Reports: root, git facts (branches, remote host, ticket key convention), whether the
project is greenfield or brownfield, languages by extension, manifests, project name,
which docs already exist and `nested_repos` (immediate subfolders that are git repos of
their own: wrapper candidates). A repo whose skeleton specd built
(`.specd/spec/scaffold/state.yml` with `step: closed`) is brownfield whatever its file
count; `scaffolded` says so. Git facts degrade to empty values outside a repository.
Exit 1 when DIR cannot be read. Stdlib only.
"""
import json
import os
import re
import subprocess
import sys
from collections import Counter

SOURCE_EXT = {
    "ts", "tsx", "js", "jsx", "mjs", "cjs", "py", "rb", "go", "rs", "java", "kt", "kts",
    "scala", "swift", "c", "cc", "cpp", "h", "hpp", "cs", "php", "ex", "exs", "erl", "hs",
    "ml", "clj", "sh", "bash", "zsh", "sql", "vue", "svelte", "dart", "lua", "r", "m", "mm",
}
SKIP_DIRS = {
    ".git", "node_modules", "vendor", "dist", "build", "target", ".venv", "venv",
    "__pycache__", ".specd", ".worktrees", "coverage", ".next", ".idea", ".cache",
}
MANIFESTS = [
    "package.json", "pyproject.toml", "setup.py", "requirements.txt", "go.mod", "Cargo.toml",
    "pom.xml", "build.gradle", "build.gradle.kts", "Gemfile", "composer.json", "Makefile",
]
DOCS_DIRS = ["docs", "doc", "documentation", "adr", "adrs"]
TICKET = re.compile(r"\b([A-Z][A-Z0-9]{1,9})-\d+\b")
TICKET_STOPLIST = {"UTF", "SHA", "ISO", "RFC", "CVE", "HTTP", "MD5", "SHA1", "SHA256", "UTF8"}
GREENFIELD_MAX_SOURCE_FILES = 5
SCAFFOLD_STATE = os.path.join(".specd", "spec", "scaffold", "state.yml")


def git(root, *args):
    """Run a git command; return stdout stripped, or None on any failure."""
    try:
        r = subprocess.run(["git", "-C", root] + list(args), capture_output=True, text=True)
    except OSError:
        return None
    if r.returncode != 0:
        return None
    return r.stdout.strip()


def has_shebang(path):
    try:
        with open(path, "rb") as f:
            return f.read(2) == b"#!"
    except OSError:
        return False


def count_sources(root):
    languages = Counter()
    for dirpath, dirnames, filenames in os.walk(root, onerror=lambda e: None):
        # nested git repos (a wrapper's code folder) are not this repo's sources
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS
                       and not os.path.exists(os.path.join(dirpath, d, ".git"))]
        for name in filenames:
            ext = name.rsplit(".", 1)[1].lower() if "." in name[1:] else ""
            if ext in SOURCE_EXT:
                languages[ext] += 1
            elif not ext and has_shebang(os.path.join(dirpath, name)):
                languages["sh"] += 1
    return sum(languages.values()), dict(sorted(languages.items()))


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def project_name(root):
    p = os.path.join(root, "package.json")
    if os.path.isfile(p):
        try:
            name = json.loads(read_text(p)).get("name")
            if isinstance(name, str) and name:
                return name
        except ValueError:
            pass
    for manifest, sections in (("pyproject.toml", ("project", "tool.poetry")),
                               ("Cargo.toml", ("package",))):
        p = os.path.join(root, manifest)
        if os.path.isfile(p):
            section = None
            for line in read_text(p).splitlines():
                m = re.match(r"^\s*\[([^\]]+)\]", line)
                if m:
                    section = m.group(1).strip()
                    continue
                m = re.match(r"^\s*name\s*=\s*[\"']([^\"']+)[\"']", line)
                if m and section in sections:
                    return m.group(1)
    p = os.path.join(root, "go.mod")
    if os.path.isfile(p):
        for line in read_text(p).splitlines():
            m = re.match(r"^module\s+(\S+)", line)
            if m:
                return m.group(1).rstrip("/").rsplit("/", 1)[-1]
    return os.path.basename(os.path.abspath(root))


def ticket_key(root):
    text = (git(root, "log", "-200", "--format=%s") or "") + "\n"
    text += git(root, "branch", "-a", "--format=%(refname:short)") or ""
    hits = Counter(p for p in TICKET.findall(text) if p not in TICKET_STOPLIST)
    if not hits:
        return "", 0
    prefix, n = hits.most_common(1)[0]
    if n < 3:
        return "", n
    return prefix + "-", n


def git_facts(root):
    out = {"git": False, "default_branch": "", "current_branch": "", "remote_host": "none",
           "remote_url": "", "ticket_key": "", "ticket_key_hits": 0}
    if git(root, "rev-parse", "--is-inside-work-tree") != "true":
        return out
    out["git"] = True
    current = git(root, "rev-parse", "--abbrev-ref", "HEAD") or ""
    out["current_branch"] = "" if current == "HEAD" else current
    head = git(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if head:
        out["default_branch"] = head.split("/", 1)[-1]
    else:
        for candidate in ("main", "master"):
            if git(root, "rev-parse", "--verify", "--quiet", "refs/heads/" + candidate) is not None:
                out["default_branch"] = candidate
                break
        else:
            out["default_branch"] = out["current_branch"]
    url = git(root, "remote", "get-url", "origin") or ""
    out["remote_url"] = url
    if "github.com" in url:
        out["remote_host"] = "github"
    elif "gitlab" in url:
        out["remote_host"] = "gitlab"
    out["ticket_key"], out["ticket_key_hits"] = ticket_key(root)
    return out


def main(argv):
    start = "."
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    if "--from" in argv:
        i = argv.index("--from")
        if i + 1 >= len(argv):
            print("specd: --from needs a directory", file=sys.stderr)
            return 2
        start = argv[i + 1]
    start = os.path.abspath(start)
    if not os.path.isdir(start) or not os.access(start, os.R_OK):
        print("specd: cannot read directory %s" % start, file=sys.stderr)
        return 1
    root = git(start, "rev-parse", "--show-toplevel") or start
    out = {"root": root}
    out.update(git_facts(root))
    source_files, languages = count_sources(root)
    scaffolded = bool(re.search(r"^step:\s*closed\b", read_text(os.path.join(root, SCAFFOLD_STATE)), re.M))
    out["scaffolded"] = scaffolded
    small = source_files < GREENFIELD_MAX_SOURCE_FILES
    out["kind"] = "greenfield" if small and not scaffolded else "brownfield"
    out["source_files"] = source_files
    out["languages"] = languages
    manifests = [m for m in MANIFESTS if os.path.isfile(os.path.join(root, m))]
    try:
        entries = sorted(os.listdir(root))
    except OSError:
        entries = []
    manifests += [e for e in entries if e.endswith((".csproj", ".sln"))]
    out["manifests"] = manifests
    out["nested_repos"] = [e for e in entries if e not in SKIP_DIRS
                           and os.path.exists(os.path.join(root, e, ".git"))]
    out["project_name"] = project_name(root)
    claude_md = os.path.join(root, "CLAUDE.md")
    out["existing"] = {
        "CLAUDE.md": os.path.isfile(claude_md),
        "AGENTS.md": os.path.isfile(os.path.join(root, "AGENTS.md")),
        "README.md": os.path.isfile(os.path.join(root, "README.md")),
        "docs_dirs": [d for d in DOCS_DIRS if os.path.isdir(os.path.join(root, d))],
        "claude_md_has_specd_block": "<!-- specd:begin -->" in read_text(claude_md),
    }
    print(json.dumps(out, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
