#!/usr/bin/env python3
"""Create the specd workspace in a repo. Idempotent; prints a JSON report.

Usage: init-workspace --root DIR [--mode embedded|wrapper] [--code NAME] [--docs REL] [--private]

Embedded (default): creates .specd/ with its folders, .specd/specd.yml (copied from the
plugin's reference), .specd/docs/lessons.md, merges the no-attribution setting into
.claude/settings.json, adds Context7 to .mcp.json and inserts the pointer block into
CLAUDE.md between the specd markers. --private keeps everything out of the team's view:
files go to CLAUDE.local.md and .claude/settings.local.json, .mcp.json is skipped and
.specd/ is git-excluded.
Wrapper: the same files at the root of DIR (specd.yml, docs/, spec/, sources/), --code NAME
names the code repo folder inside DIR, which is gitignored together with .worktrees/;
--docs REL (default docs) puts the docs folder elsewhere, e.g. NAME/docs to ship them with
the code. --private is refused: the wrapper is the user's own repo.
Each artifact is reported as created, merged or skipped. Exit 1 on refusal. Stdlib only.
"""
import json
import os
import re
import sys

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LAYOUT = {"embedded": ".specd/", "wrapper": ""}  # folder prefix of the workspace files
SUBFOLDERS = ["", "docs", "docs/architecture", "docs/decisions", "docs/data-models",
              "docs/features", "spec", "sources"]
BEGIN, END = "<!-- specd:begin -->", "<!-- specd:end -->"
CONTEXT7 = {"type": "http", "url": "https://mcp.context7.com/mcp"}
MCP_HINT = "run: claude mcp add --transport http context7 https://mcp.context7.com/mcp"
EXCLUDES = [".specd/", "CLAUDE.local.md", ".claude/settings.local.json"]
WORKTREES = ".worktrees/"

report = {"mode": "embedded", "private": False, "created": [], "merged": [], "skipped": [],
          "warnings": []}


def fail(msg):
    print("specd: %s" % msg, file=sys.stderr)
    return 1


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


def fence(relpath, lang):
    text = read(os.path.join(PLUGIN_ROOT, relpath))
    blocks = re.findall(r"```%s\n(.*?)```" % lang, text, re.S)
    if len(blocks) != 1:
        raise ValueError("%s must contain exactly one %s fence, found %d" % (relpath, lang, len(blocks)))
    return blocks[0]


def skip(path, reason):
    report["skipped"].append({"path": path, "reason": reason})


def ensure_folders(root, prefix, docs_rel):
    for rel in SUBFOLDERS:
        if rel.startswith("docs"):
            rel = docs_rel + rel[len("docs"):]
        else:
            rel = prefix + rel
        rel = rel.rstrip("/")
        if not rel:
            continue
        p = os.path.join(root, rel)
        if os.path.isdir(p):
            skip(p, "exists")
        else:
            os.makedirs(p)
            report["created"].append(p)


def ensure_file(path, text):
    if os.path.exists(path):
        skip(path, "exists")
    else:
        write(path, text)
        report["created"].append(path)


def merge_settings(path, attribution):
    data = {}
    if os.path.exists(path):
        try:
            data = json.loads(read(path))
            if not isinstance(data, dict):
                raise ValueError("top level is not an object")
        except ValueError as e:
            report["warnings"].append("%s not merged: cannot parse (%s)" % (path, e))
            return
    if data.get("attribution") == attribution:
        skip(path, "attribution already set")
        return
    existed = os.path.exists(path)
    data["attribution"] = attribution
    write(path, json.dumps(data, indent=2) + "\n")
    (report["merged"] if existed else report["created"]).append(path)


def merge_mcp(path):
    data = {}
    if os.path.exists(path):
        try:
            data = json.loads(read(path))
            if not isinstance(data, dict):
                raise ValueError("top level is not an object")
        except ValueError as e:
            report["warnings"].append("%s not merged: cannot parse (%s)" % (path, e))
            return
    servers = data.setdefault("mcpServers", {})
    if not isinstance(servers, dict):
        report["warnings"].append("%s not merged: mcpServers is not an object" % path)
        return
    if "context7" in servers:
        skip(path, "context7 already configured")
        return
    existed = os.path.exists(path)
    servers["context7"] = CONTEXT7
    write(path, json.dumps(data, indent=2) + "\n")
    (report["merged"] if existed else report["created"]).append(path)


def insert_block(path, block):
    block = block.rstrip("\n") + "\n"
    if not os.path.exists(path):
        write(path, block)
        report["created"].append(path)
        return
    text = read(path)
    b, e = text.find(BEGIN), text.find(END)
    if b >= 0 and e > b:
        e += len(END)
        current = text[b:e] + "\n"
        if current == block:
            skip(path, "block up to date")
            return
        new = text[:b] + block.rstrip("\n") + text[e:]
        write(path, new)
        report["merged"].append(path)
        return
    if b >= 0 or e >= 0:
        report["warnings"].append("%s has an unmatched specd marker; block not inserted" % path)
        return
    sep = "" if text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
    write(path, text + sep + block)
    report["merged"].append(path)


def git_dir(root):
    p = os.path.join(root, ".git")
    if os.path.isdir(p):
        return p
    if os.path.isfile(p):
        m = re.match(r"gitdir:\s*(.+)", read(p).strip())
        if m:
            return os.path.normpath(os.path.join(root, m.group(1).strip()))
    return None


def ensure_lines(path, lines, label):
    """Append the missing LINES to the text file at PATH (created when absent)."""
    existing = read(path).splitlines() if os.path.exists(path) else []
    missing = [x for x in lines if x not in existing]
    if not missing:
        skip(path, "%s present" % label)
        return
    text = "\n".join(existing + missing) + "\n"
    existed = os.path.exists(path)
    write(path, text)
    (report["merged"] if existed else report["created"]).append(path)


def ensure_excludes(root):
    gd = git_dir(root)
    if not gd or not os.path.isdir(gd):
        report["warnings"].append("cannot resolve the git dir; add %s to .git/info/exclude by hand"
                                  % ", ".join(EXCLUDES))
        return
    ensure_lines(os.path.join(gd, "info", "exclude"), EXCLUDES, "excludes")


def render_claude_md(template, docs_rel, code):
    """Fill the placeholders; lines about the code folder exist only in wrapper mode."""
    lines = [l for l in template.splitlines() if code or "{{code_root}}" not in l]
    text = "\n".join(lines) + "\n"
    return text.replace("{{docs_root}}", docs_rel).replace("{{code_root}}", code or "")


def opt(argv, flag, default=None):
    if flag in argv:
        i = argv.index(flag)
        if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
            raise ValueError("%s needs a value" % flag)
        return argv[i + 1]
    return default


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    try:
        root, mode = opt(argv, "--root"), opt(argv, "--mode", "embedded")
        code, docs_rel = opt(argv, "--code"), opt(argv, "--docs")
    except ValueError as e:
        return fail(str(e))
    if not root:
        return fail("--root DIR is required")
    if mode not in LAYOUT:
        return fail("--mode must be embedded or wrapper")
    root = os.path.abspath(root)
    private = "--private" in argv
    report["mode"], report["private"] = mode, private
    prefix = LAYOUT[mode]
    if mode == "wrapper":
        if private:
            return fail("--private does not apply to a wrapper; it is your own repo")
        if not code or os.sep in code or code in (".", ".."):
            return fail("--code NAME (the code folder inside the wrapper) is required")
        if not os.path.exists(os.path.join(root, code, ".git")):
            return fail("%s is not a git repository inside %s" % (code, root))
    elif code or docs_rel:
        return fail("--code and --docs apply to --mode wrapper only")
    docs_rel = docs_rel or prefix + "docs"
    if not os.path.isdir(root):
        return fail("no such directory: %s" % root)
    if not os.path.exists(os.path.join(root, ".git")):
        return fail("%s is not a git repository; run git init first" % root)
    try:
        config = fence("skills/_shared/specd-yml.md", "yaml")
        attribution = json.loads(fence("skills/_shared/no-attribution.md", "json"))["attribution"]
        claude_md = read(os.path.join(PLUGIN_ROOT, "skills/init/templates/CLAUDE.md"))
        lessons = read(os.path.join(PLUGIN_ROOT, "skills/init/templates/lessons.md"))
    except (OSError, ValueError, KeyError) as e:
        return fail("plugin files unreadable: %s" % e)

    ensure_folders(root, prefix, docs_rel)
    ensure_file(os.path.join(root, prefix + "specd.yml"), config)
    ensure_file(os.path.join(root, docs_rel, "lessons.md"), lessons)
    settings = ".claude/settings.local.json" if private else ".claude/settings.json"
    merge_settings(os.path.join(root, settings), attribution)
    if private:
        skip(os.path.join(root, ".mcp.json"), "private mode")
        report["warnings"].append(MCP_HINT)
    else:
        merge_mcp(os.path.join(root, ".mcp.json"))
    target = "CLAUDE.local.md" if private else "CLAUDE.md"
    insert_block(os.path.join(root, target), render_claude_md(claude_md, docs_rel, code))
    if private:
        ensure_excludes(root)
    if mode == "wrapper":
        ensure_lines(os.path.join(root, ".gitignore"), [code + "/", WORKTREES], "ignores")
    path = os.path.join(root, target)
    if os.path.exists(path) and read(path).count("\n") > 60:
        report["warnings"].append("%s exceeds 60 lines; trim what is outside the specd markers" % path)
    print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
