#!/usr/bin/env python3
"""Create the pacenote workspace in a repo. Idempotent; prints a JSON report.

Usage: init-workspace --root DIR [--assistant claude|codex|cursor] [--mode embedded|wrapper]
                      [--code NAME] [--docs REL] [--private]
       init-workspace --root DIR --add-mcp NAME

Embedded (default): creates .pacenote/ with its folders, .pacenote/pacenote.yml (copied from the
plugin's reference), .pacenote/docs/lessons.md, merges the no-attribution setting into
.claude/settings.json, adds Context7 to .mcp.json and inserts the pointer block into
CLAUDE.md between the pacenote markers. --private keeps everything out of the team's view:
files go to CLAUDE.local.md and .claude/settings.local.json, .mcp.json is skipped and
.pacenote/ is git-excluded.
Wrapper: the same files at the root of DIR (pacenote.yml, docs/, spec/, sources/), --code NAME
names the code repo folder inside DIR, which is gitignored together with .worktrees/;
--docs REL (default docs) puts the docs folder elsewhere, e.g. NAME/docs to ship them with
the code. --private is refused: the wrapper is the user's own repo.
--add-mcp NAME (atlassian, playwright, chrome-devtools, dbhub) only merges that MCP server
into DIR/.mcp.json, the file init wrote (embedded: the repo root; wrapper: the wrapper root);
in a private workspace (.pacenote/ git-excluded) it is skipped with a `claude mcp add` hint.
dbhub reads its connection string from the DATABASE_URL environment variable, never from
the file.
--assistant (default claude) picks the assistant's files from skills/_shared/runtime.md:
claude as above; codex and cursor get the pointer block in AGENTS.md (no @-imports), the
MCP servers in .codex/config.toml or .cursor/mcp.json, and no attribution setting (none is
documented); codex also gets the plugin's generated agents copied to .codex/agents/
(Codex loads no plugin agents). Every assistant gets pacenote.local.yml next to
pacenote.yml: `assistant:` plus, for codex and cursor, their `models.*`, gitignored through
<workspace>/.gitignore; never the shared pacenote.yml. Running init again with another
assistant adds that assistant's files and switches the local file. In private mode
AGENTS.md is written only when it is new and is then git-excluded, and so are copied agents.
--add-mcp writes to the MCP file of the assistant in pacenote.local.yml.
Each artifact is reported as created, merged or skipped. Exit 1 on refusal. Stdlib only.
"""
import importlib.util
import json
import os
import re
import shutil
import sys
from importlib.machinery import SourceFileLoader

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LAYOUT = {"embedded": ".pacenote/", "wrapper": ""}  # folder prefix of the workspace files
SUBFOLDERS = ["", "docs", "docs/architecture", "docs/decisions", "docs/data-models",
              "docs/features", "spec", "sources"]
BEGIN, END = "<!-- pacenote:begin -->", "<!-- pacenote:end -->"
MCP_SERVERS = {
    "context7": {"type": "http", "url": "https://mcp.context7.com/mcp"},
    "atlassian": {"type": "http", "url": "https://mcp.atlassian.com/v1/mcp"},
    "playwright": {"command": "npx", "args": ["@playwright/mcp@latest"]},
    "chrome-devtools": {"command": "npx", "args": ["-y", "chrome-devtools-mcp@latest"]},
    "dbhub": {"command": "npx", "args": ["-y", "@bytebase/dbhub@latest", "--transport", "stdio"],
              "env": {"DSN": "${DATABASE_URL}"}},
}
EXCLUDES = [".pacenote/", "CLAUDE.local.md", ".claude/settings.local.json"]
WORKTREES = ".worktrees/"

LOCAL = "pacenote.local.yml"
GENERATED_AGENT = "# Generated by scripts/codex-agents"

report = {"mode": "embedded", "assistant": "claude", "private": False, "created": [], "merged": [], "skipped": [],
          "warnings": []}


def fail(msg):
    print("pacenote: %s" % msg, file=sys.stderr)
    return 1


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


def fence(relpath, lang):
    text = read(os.path.join(PLUGIN_ROOT, relpath))
    blocks = re.findall(r"```%s\n(.*?)```" % lang, text, re.S)
    if len(blocks) != 1:
        raise ValueError("%s must contain exactly one %s fence, found %d" % (relpath, lang, len(blocks)))
    return blocks[0]


def skip(path, reason):
    report["skipped"].append({"path": path, "reason": reason})


def ensure_folders(root, prefix, docs_rel):
    for rel in SUBFOLDERS:
        if rel.startswith("docs"):
            rel = docs_rel + rel[len("docs"):]
        else:
            rel = prefix + rel
        rel = rel.rstrip("/")
        if not rel:
            continue
        p = os.path.join(root, rel)
        if os.path.isdir(p):
            skip(p, "exists")
        else:
            os.makedirs(p)
            report["created"].append(p)


def ensure_file(path, text):
    if os.path.exists(path):
        skip(path, "exists")
    else:
        write(path, text)
        report["created"].append(path)


def load_runtime():
    loader = SourceFileLoader("pacenote_runtime", os.path.join(PLUGIN_ROOT, "scripts", "runtime"))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def mcp_hint(name, assistant="claude"):
    server = MCP_SERVERS[name]
    if assistant == "codex":
        if "url" in server:
            return "run: codex mcp add %s --url %s" % (name, server["url"])
        env = "".join(" --env %s=<value>" % k for k in sorted(server.get("env", {})))
        return "run: codex mcp add%s %s -- %s" % (env, name, " ".join([server["command"]] + server["args"]))
    if assistant == "cursor":
        return "add %s to ~/.cursor/mcp.json: %s" % (name, json.dumps(cursor_server(server)))
    if "url" in server:
        return "run: claude mcp add --transport %s %s %s" % (server["type"], name, server["url"])
    env = "".join(' -e %s="%s"' % (k, re.sub(r"\$\{(\w+)\}", r"$\1", v))
                  for k, v in sorted(server.get("env", {}).items()))
    return "run: claude mcp add%s %s -- %s" % (env, name, " ".join([server["command"]] + server["args"]))


def merge_settings(path, attribution):
    data = {}
    if os.path.exists(path):
        try:
            data = json.loads(read(path))
            if not isinstance(data, dict):
                raise ValueError("top level is not an object")
        except ValueError as e:
            report["warnings"].append("%s not merged: cannot parse (%s)" % (path, e))
            return
    if data.get("attribution") == attribution:
        skip(path, "attribution already set")
        return
    existed = os.path.exists(path)
    data["attribution"] = attribution
    write(path, json.dumps(data, indent=2) + "\n")
    (report["merged"] if existed else report["created"]).append(path)


def merge_mcp(path, name="context7", server=None):
    data = {}
    if os.path.exists(path):
        try:
            data = json.loads(read(path))
            if not isinstance(data, dict):
                raise ValueError("top level is not an object")
        except ValueError as e:
            report["warnings"].append("%s not merged: cannot parse (%s)" % (path, e))
            return
    servers = data.setdefault("mcpServers", {})
    if not isinstance(servers, dict):
        report["warnings"].append("%s not merged: mcpServers is not an object" % path)
        return
    if name in servers:
        skip(path, "%s already configured" % name)
        return
    existed = os.path.exists(path)
    servers[name] = server or MCP_SERVERS[name]
    write(path, json.dumps(data, indent=2) + "\n")
    (report["merged"] if existed else report["created"]).append(path)


def cursor_server(server):
    out = {k: v for k, v in server.items() if k != "type"}
    if "env" in out:
        out["env"] = {k: re.sub(r"\$\{(\w+)\}", r"${env:\1}", v) for k, v in out["env"].items()}
    return out


def toml_value(v):
    if isinstance(v, list):
        return "[%s]" % ", ".join(json.dumps(x) for x in v)
    return json.dumps(v)


def merge_codex_mcp(path, name="context7"):
    """Append [mcp_servers.NAME] to a config.toml; servers that need env are left to the user."""
    text = read(path) if os.path.exists(path) else ""
    if re.search(r"^\[mcp_servers\.%s\]" % re.escape(name), text, re.M):
        skip(path, "%s already configured" % name)
        return
    server = MCP_SERVERS[name]
    if "env" in server:
        skip(path, "%s needs an environment variable" % name)
        report["warnings"].append(mcp_hint(name, "codex"))
        return
    lines = ["[mcp_servers.%s]" % name]
    lines += ["url = %s" % json.dumps(server["url"])] if "url" in server else [
        "command = %s" % json.dumps(server["command"]), "args = %s" % toml_value(server["args"])]
    sep = "" if not text or text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
    write(path, text + sep + "\n".join(lines) + "\n")
    (report["merged"] if text else report["created"]).append(path)


def merge_assistant_mcp(root, assistant, name="context7"):
    target = os.path.join(root, load_runtime().table()[assistant]["mcp_file"])
    if assistant == "codex":
        merge_codex_mcp(target, name)
    elif assistant == "cursor":
        merge_mcp(target, name, cursor_server(MCP_SERVERS[name]))
    else:
        merge_mcp(target, name)


def write_local(workspace, assistant):
    """Set assistant (and its models block) in pacenote.local.yml; keep any other key."""
    path = os.path.join(workspace, LOCAL)
    models = load_runtime().table()[assistant]["models"]
    new = ["assistant: %s" % assistant]
    if models:
        new += ["models:"] + ["  %s: %s" % (r, models[r]) for r in ("judgment", "execution", "cheap")]
    old = read(path).splitlines() if os.path.exists(path) else [
        "# Personal pacenote settings: gitignored, read after pacenote.yml (DECISIONS 2026-11-19 M8)."]
    kept, section = [], None
    for line in old:
        m = re.match(r"^([A-Za-z_][\w-]*):", line)
        if m:
            section = m.group(1)
        if section in ("assistant", "models"):
            continue
        kept.append(line)
    text = "\n".join(kept + new) + "\n"
    if os.path.exists(path) and read(path) == text:
        skip(path, "assistant already %s" % assistant)
        return
    existed = os.path.exists(path)
    write(path, text)
    (report["merged"] if existed else report["created"]).append(path)


def copy_codex_agents(root, private):
    src = os.path.join(PLUGIN_ROOT, ".codex", "agents")
    dst = os.path.join(root, ".codex", "agents")
    copied = []
    for fn in sorted(os.listdir(src)):
        if not fn.endswith(".toml"):
            continue
        target, text = os.path.join(dst, fn), read(os.path.join(src, fn))
        if os.path.exists(target):
            current = read(target)
            if current == text:
                skip(target, "up to date")
                continue
            if not current.startswith(GENERATED_AGENT):
                report["warnings"].append("%s is not pacenote's; left as is" % target)
                continue
        existed = os.path.exists(target)
        write(target, text)
        (report["merged"] if existed else report["created"]).append(target)
        copied.append(".codex/agents/" + fn)
    if private and copied:
        gd = git_dir(root)
        if gd:
            ensure_lines(os.path.join(gd, "info", "exclude"), copied, "excludes")


def insert_block(path, block):
    block = block.rstrip("\n") + "\n"
    if not os.path.exists(path):
        write(path, block)
        report["created"].append(path)
        return
    text = read(path)
    b, e = text.find(BEGIN), text.find(END)
    if b >= 0 and e > b:
        e += len(END)
        current = text[b:e] + "\n"
        if current == block:
            skip(path, "block up to date")
            return
        new = text[:b] + block.rstrip("\n") + text[e:]
        write(path, new)
        report["merged"].append(path)
        return
    if b >= 0 or e >= 0:
        report["warnings"].append("%s has an unmatched pacenote marker; block not inserted" % path)
        return
    sep = "" if text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
    write(path, text + sep + block)
    report["merged"].append(path)


def git_dir(root):
    p = os.path.join(root, ".git")
    if os.path.isdir(p):
        return p
    if os.path.isfile(p):
        m = re.match(r"gitdir:\s*(.+)", read(p).strip())
        if m:
            return os.path.normpath(os.path.join(root, m.group(1).strip()))
    return None


def ensure_lines(path, lines, label):
    """Append the missing LINES to the text file at PATH (created when absent)."""
    existing = read(path).splitlines() if os.path.exists(path) else []
    missing = [x for x in lines if x not in existing]
    if not missing:
        skip(path, "%s present" % label)
        return
    text = "\n".join(existing + missing) + "\n"
    existed = os.path.exists(path)
    write(path, text)
    (report["merged"] if existed else report["created"]).append(path)


def ensure_excludes(root):
    gd = git_dir(root)
    if not gd or not os.path.isdir(gd):
        report["warnings"].append("cannot resolve the git dir; add %s to .git/info/exclude by hand"
                                  % ", ".join(EXCLUDES))
        return
    ensure_lines(os.path.join(gd, "info", "exclude"), EXCLUDES, "excludes")


def render_claude_md(template, docs_rel, code, command="/pacenote:{step}"):
    """Fill the placeholders; lines about the code folder exist only in wrapper mode."""
    lines = [l for l in template.splitlines() if code or "{{code_root}}" not in l]
    text = "\n".join(lines) + "\n"
    text = re.sub(r"\{\{cmd (\S+)\}\}", lambda m: command.replace("{step}", m.group(1)), text)
    return text.replace("{{docs_root}}", docs_rel).replace("{{code_root}}", code or "")


def opt(argv, flag, default=None):
    if flag in argv:
        i = argv.index(flag)
        if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
            raise ValueError("%s needs a value" % flag)
        return argv[i + 1]
    return default


def add_mcp(root, name):
    if name not in MCP_SERVERS or name == "context7":
        return fail("--add-mcp takes one of: %s" % ", ".join(n for n in MCP_SERVERS if n != "context7"))
    rt = load_runtime()
    assistant = rt.info(root)["assistant"]
    assistant = assistant if assistant in rt.ASSISTANTS else "claude"
    report["assistant"] = assistant
    gd = git_dir(root)
    exclude = os.path.join(gd, "info", "exclude") if gd else ""
    if exclude and os.path.isfile(exclude) and ".pacenote/" in read(exclude).splitlines():
        report["private"] = True
        skip(os.path.join(root, rt.table()[assistant]["mcp_file"]), "private mode")
        report["warnings"].append(mcp_hint(name, assistant))
    else:
        merge_assistant_mcp(root, assistant, name)
    print(json.dumps(report, indent=2))
    return 0


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    if "--add-mcp" in argv:
        try:
            root, name = opt(argv, "--root"), opt(argv, "--add-mcp")
        except ValueError as e:
            return fail(str(e))
        if not root or not os.path.isdir(root):
            return fail("--root DIR is required and must exist")
        return add_mcp(os.path.abspath(root), name)
    try:
        root, mode = opt(argv, "--root"), opt(argv, "--mode", "embedded")
        code, docs_rel = opt(argv, "--code"), opt(argv, "--docs")
        assistant = opt(argv, "--assistant", "claude")
    except ValueError as e:
        return fail(str(e))
    if not root:
        return fail("--root DIR is required")
    if mode not in LAYOUT:
        return fail("--mode must be embedded or wrapper")
    if assistant not in ("claude", "codex", "cursor"):
        return fail("--assistant must be claude, codex or cursor")
    report["assistant"] = assistant
    root = os.path.abspath(root)
    private = "--private" in argv
    report["mode"], report["private"] = mode, private
    prefix = LAYOUT[mode]
    if mode == "wrapper":
        if private:
            return fail("--private does not apply to a wrapper; it is your own repo")
        if not code or os.sep in code or code in (".", ".."):
            return fail("--code NAME (the code folder inside the wrapper) is required")
        if not os.path.exists(os.path.join(root, code, ".git")):
            return fail("%s is not a git repository inside %s" % (code, root))
    elif code or docs_rel:
        return fail("--code and --docs apply to --mode wrapper only")
    docs_rel = docs_rel or prefix + "docs"
    if not os.path.isdir(root):
        return fail("no such directory: %s" % root)
    if not os.path.exists(os.path.join(root, ".git")):
        return fail("%s is not a git repository; run git init first" % root)
    try:
        config = fence("skills/_shared/pacenote-yml.md", "yaml")
        attribution = json.loads(fence("skills/_shared/no-attribution.md", "json"))["attribution"]
        memory = "CLAUDE.md" if assistant == "claude" else "AGENTS.md"
        claude_md = read(os.path.join(PLUGIN_ROOT, "skills/init/templates", memory))
        command = load_runtime().table()[assistant]["command"]
        lessons = read(os.path.join(PLUGIN_ROOT, "skills/init/templates/lessons.md"))
    except (OSError, ValueError, KeyError) as e:
        return fail("plugin files unreadable: %s" % e)

    ensure_folders(root, prefix, docs_rel)
    ensure_file(os.path.join(root, prefix + "pacenote.yml"), config)
    ensure_file(os.path.join(root, docs_rel, "lessons.md"), lessons)
    workspace = os.path.join(root, prefix.rstrip("/")) if prefix else root
    write_local(workspace, assistant)
    ensure_lines(os.path.join(workspace, ".gitignore"), [LOCAL], "ignores")
    block = render_claude_md(claude_md, docs_rel, code, command)
    if assistant == "claude":
        settings = ".claude/settings.local.json" if private else ".claude/settings.json"
        merge_settings(os.path.join(root, settings), attribution)
        target = "CLAUDE.local.md" if private else "CLAUDE.md"
    else:
        target = "AGENTS.md"
    mcp_file = load_runtime().table()[assistant]["mcp_file"]
    if private:
        skip(os.path.join(root, mcp_file), "private mode")
        report["warnings"].append(mcp_hint("context7", assistant))
    else:
        merge_assistant_mcp(root, assistant)
    if private and target == "AGENTS.md" and os.path.exists(os.path.join(root, target)) \
            and BEGIN not in read(os.path.join(root, target)):
        skip(os.path.join(root, target), "private mode: AGENTS.md is the team's file")
        report["warnings"].append("add the pacenote block to AGENTS.md by hand, or keep it local")
    else:
        new_agents_md = target == "AGENTS.md" and not os.path.exists(os.path.join(root, target))
        insert_block(os.path.join(root, target), block)
        if private and new_agents_md:
            gd = git_dir(root)
            if gd:
                ensure_lines(os.path.join(gd, "info", "exclude"), ["AGENTS.md"], "excludes")
    if assistant == "codex":
        copy_codex_agents(root, private)
    if private:
        ensure_excludes(root)
    if mode == "wrapper":
        ensure_lines(os.path.join(root, ".gitignore"), [code + "/", WORKTREES], "ignores")
    path = os.path.join(root, target)
    if os.path.exists(path) and read(path).count("\n") > 60:
        report["warnings"].append("%s exceeds 60 lines; trim what is outside the pacenote markers" % path)
    print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
