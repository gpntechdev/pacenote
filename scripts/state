#!/usr/bin/env python3
"""Own a feature's state.yml: create it, read it, patch it, guard steps, find and list features.

Usage:
  state init     --file PATH --feature NAME --tier TIER [--retention R] [--step S] [--branch B]
                 [--worktree REL]
  state get      --file PATH [key ...]
  state set      --file PATH key=value [key=value ...]
  state check    --file PATH --step STEP
  state escalate --file PATH --to TIER [--signal S]
  state find     --spec-root DIR [--worktrees DIR] [--feature NAME] [--branch BRANCH]
  state list     --spec-root DIR [--worktrees DIR]

Keys are `top` or `section.key`. `set` patches lines in place (comments, order and unknown
keys survive), may add missing `tasks.<id>` keys, accepts `now` as an ISO-8601 UTC timestamp
and `step=next` as the step that follows the current one in the tier's order (skipping
review and docs once a PR is recorded), always sets `updated`, and is all-or-nothing.
`init` without `--step` picks the first step after start for the tier. `check` exits 1 with
`run_first` when STEP may not run yet, is not in the tier's flow (`escalate` names the way
up), or needs a reproduction first (fix features); `--step feedback` passes whenever a PR is
recorded and the feature is not closed. `escalate` raises the tier, rewinds `step` to the
first step the old order lacked, clears the gates from there on and keeps every file and
done task. `find` resolves the feature by name, then by branch, then as the only open one;
`list` reports every feature. Both also scan the feature worktrees under `--worktrees DIR`
(`DIR/<name>/`, each a workspace of its own, resolved through resolve-paths), so the
wrapper root sees features that live in worktrees; rows carry `worktree`.
The step order per tier lives here and nowhere else.
Every command prints JSON; refusals print one line on stderr and exit 1. Stdlib only.
"""
import glob
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REFERENCE = os.path.join(PLUGIN_ROOT, "skills", "_shared", "state-yml.md")
RESOLVE_PATHS = os.path.join(PLUGIN_ROOT, "scripts", "resolve-paths")
LINE = re.compile(r"^(\s*)([A-Za-z_][\w-]*):(\s*)(.*?)(\s*#.*)?$")
BARE = re.compile(r"^(true|false|-?\d+|[a-z_]+|[A-Z]\d+)$")
STEPS = ["start", "specify", "design", "tasks", "implement", "review", "verify", "docs",
         "deliver", "close", "closed"]
SIDE_STEPS = ("feedback",)  # not a position in the order: checked on their own condition
TIERS = ("trivial", "quick", "full")
ORDERS = {  # the step order per tier; docs joins a light order when retention is distill
    "trivial": ["start", "implement", "deliver", "close", "closed"],
    "quick": ["start", "specify", "implement", "review", "deliver", "close", "closed"],
    "full": STEPS,
}
PR_SKIPS = ("review", "docs")  # once a PR is recorded, the fix loop skips these
STEP_GATE = {"specify": "G1", "design": "G2", "tasks": "G3", "implement": "G4", "deliver": "G5"}
RETENTIONS = ("", "distill", "clean", "keep")
ADDABLE_SECTIONS = ("tasks",)


def fail(msg):
    print("specd: %s" % msg, file=sys.stderr)
    return 1


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_lines(path):
    with open(path, encoding="utf-8") as f:
        return f.readlines()


def write_lines(path, lines):
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(lines)


def index(lines):
    """Map `top` / `section.key` -> line number. Returns (found, section_lines, bad)."""
    found, sections, bad = {}, {}, []
    section = None
    for n, raw in enumerate(lines):
        stripped = raw.strip()
        if not stripped or stripped.startswith("#") or stripped.startswith("- "):
            continue
        m = LINE.match(raw.rstrip("\n"))
        if not m:
            bad.append(n + 1)
            continue
        indent, key = len(m.group(1)), m.group(2)
        if indent == 0:
            section = key
            found[key] = n
            sections[key] = n
        elif section:
            found["%s.%s" % (section, key)] = n
        else:
            bad.append(n + 1)
    return found, sections, bad


def value_of(lines, n):
    m = LINE.match(lines[n].rstrip("\n"))
    v = m.group(4).strip()
    if v in ("{}", "[]"):
        return ""
    return v.strip("\"'")


def typed(v):
    if v == "true":
        return True
    if v == "false":
        return False
    if re.match(r"^-?\d+$", v):
        return int(v)
    return v


def load(path):
    """Return the file as {top: value, section: {key: value}} with typed scalars."""
    lines = read_lines(path)
    found, sections, bad = index(lines)
    if bad:
        raise ValueError("cannot parse %s line %s" % (path, ", ".join(str(b) for b in bad)))
    out = {}
    for name, n in found.items():
        if "." in name:
            sec, key = name.split(".", 1)
            out.setdefault(sec, {})[key] = typed(value_of(lines, n))
        elif name in sections and any(k.startswith(name + ".") for k in found):
            out.setdefault(name, {})
        else:
            out[name] = typed(value_of(lines, n))
    return out


def render(value):
    if BARE.match(value):
        return value
    return '"%s"' % value


def patch(path, pairs):
    """Apply key=value pairs; returns the change list. Raises ValueError on refusal."""
    lines = read_lines(path)
    found, sections, bad = index(lines)
    if bad:
        raise ValueError("cannot parse %s line %s" % (path, ", ".join(str(b) for b in bad)))
    changes, additions = [], []
    for key, value in pairs:
        if '"' in value or "\n" in value:
            raise ValueError("value for %s may not contain a double quote or newline" % key)
        if value == "now":
            value = now()
        if key in found:
            n = found[key]
            m = LINE.match(lines[n].rstrip("\n"))
            if m.group(4).strip() in ("{}", "[]") and "." not in key:
                raise ValueError("%s is a section; set %s.<key> instead" % (key, key))
            changes.append((key, n, value))
        elif "." in key and key.split(".", 1)[0] in ADDABLE_SECTIONS:
            sec = key.split(".", 1)[0]
            if sec not in sections:
                raise ValueError("no %s section in %s" % (sec, path))
            additions.append((key, value))
        else:
            raise ValueError("unknown key %s in %s" % (key, path))
    out = []
    for key, n, value in changes:
        m = LINE.match(lines[n].rstrip("\n"))
        old, comment = m.group(4), m.group(5) or ""
        new = render(value)
        gap = m.group(3) if old else " "
        if comment:
            column = len(m.group(1)) + len(m.group(2)) + 1 + len(m.group(3)) + len(old)
            shift = column + len(comment) - len(comment.lstrip())
            comment = " " * max(1, shift - column - (len(new) - len(old))) + comment.lstrip()
        lines[n] = "%s%s:%s%s%s\n" % (m.group(1), m.group(2), gap, new, comment)
        out.append({"key": key, "old": old.strip(), "new": new})
    for key, value in additions:
        sec, sub = key.split(".", 1)
        found, sections, _ = index(lines)
        n = sections[sec]
        m = LINE.match(lines[n].rstrip("\n"))
        if m.group(4).strip() in ("{}", "[]"):
            comment = m.group(5) or ""
            lines[n] = "%s%s:%s%s%s\n" % (m.group(1), m.group(2), m.group(3),
                                           " " * len(m.group(4)), comment)
        last = max([i for k, i in found.items() if k.startswith(sec + ".")] + [n])
        lines.insert(last + 1, "  %s: %s\n" % (sub, render(value)))
        out.append({"key": key, "old": "", "new": render(value)})
    write_lines(path, lines)
    return out


def order_for(tier, retention=""):
    """The step order of a tier; light tiers run docs only when retention is distill."""
    if tier not in ORDERS:
        raise ValueError("state.yml has unknown tier %r" % tier)
    steps = list(ORDERS[tier])
    if tier != "full" and retention == "distill":
        steps.insert(steps.index("deliver"), "docs")
    return steps


def order(data):
    return order_for(str(data.get("tier", "full")), str(data.get("retention", "")))


def next_step(data, current=None):
    """The step after `current` (default: the file's step) in the tier's order."""
    steps = order(data)
    current = str(current or data.get("step", "start"))
    if current not in steps:
        raise ValueError("step %s is not in the %s flow" % (current, data.get("tier")))
    rest = steps[steps.index(current) + 1:]
    if str(data.get("pr", "")).strip():
        rest = [s for s in rest if s not in PR_SKIPS]
    if not rest:
        raise ValueError("nothing follows %s" % current)
    return rest[0]


def resolve_next(path, pairs):
    """Replace `step=next` with the real successor, read from the file as it is."""
    if ("step", "next") not in pairs:
        return pairs
    target = next_step(load(path))
    return [(k, target if (k, v) == ("step", "next") else v) for k, v in pairs]


def reference_default():
    with open(REFERENCE, encoding="utf-8") as f:
        blocks = re.findall(r"```yaml\n(.*?)```", f.read(), re.S)
    if len(blocks) != 1:
        raise ValueError("%s must contain exactly one yaml fence, found %d" % (REFERENCE, len(blocks)))
    return blocks[0]


def opt(argv, flag, default=None):
    if flag in argv:
        i = argv.index(flag)
        if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
            raise ValueError("%s needs a value" % flag)
        return argv[i + 1]
    return default


def cmd_init(argv):
    path, feature, tier = opt(argv, "--file"), opt(argv, "--feature"), opt(argv, "--tier")
    if not (path and feature and tier):
        raise ValueError("init needs --file, --feature and --tier")
    if tier not in TIERS:
        raise ValueError("tier must be one of %s" % ", ".join(TIERS))
    retention = opt(argv, "--retention", "")
    if retention not in RETENTIONS:
        raise ValueError("retention must be distill, clean or keep")
    step = opt(argv, "--step", "")
    if step and step not in STEPS:
        raise ValueError("unknown step %s" % step)
    if not step:
        step = next_step({"tier": tier, "retention": retention}, "start")
    if os.path.exists(path):
        raise ValueError("%s exists; state init never overwrites" % path)
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(reference_default())
    pairs = [("feature", feature), ("tier", tier), ("step", step), ("retention", retention),
             ("branch", opt(argv, "--branch", "")), ("worktree", opt(argv, "--worktree", "")),
             ("created", "now")]
    changes = patch(path, [(k, v) for k, v in pairs if v != "" or k == "retention"])
    patch(path, [("updated", "now")])
    return {"file": os.path.abspath(path), "created": True, "changes": changes}


def cmd_get(argv):
    path = opt(argv, "--file")
    if not path:
        raise ValueError("get needs --file")
    keys = [a for a in argv[1:] if not a.startswith("--") and a != path]
    data = load(path)
    if not keys:
        return data
    out = {}
    for key in keys:
        if "." in key:
            sec, sub = key.split(".", 1)
            out[key] = data.get(sec, {}).get(sub) if isinstance(data.get(sec), dict) else None
        else:
            out[key] = data.get(key)
    return out


def cmd_set(argv):
    path = opt(argv, "--file")
    if not path:
        raise ValueError("set needs --file")
    pairs = []
    for a in argv[1:]:
        if a == "--file" or a == path or a.startswith("--"):
            continue
        if "=" not in a:
            raise ValueError("expected key=value, got %r" % a)
        pairs.append(tuple(a.split("=", 1)))
    if not pairs:
        raise ValueError("no key=value given")
    if not os.path.isfile(path):
        raise ValueError("no such file: %s" % path)
    changes = patch(path, resolve_next(path, pairs) + [("updated", "now")])
    return {"file": os.path.abspath(path), "changes": changes}


def gate_ok(data, gate):
    return bool(str(data.get("gates", {}).get(gate, "")).strip())


def cmd_check(argv):
    path, step = opt(argv, "--file"), opt(argv, "--step")
    if not (path and step):
        raise ValueError("check needs --file and --step")
    if step not in STEPS + list(SIDE_STEPS) or step == "closed":
        raise ValueError("unknown step %s" % step)
    if not os.path.isfile(path):
        return {"ok": False, "reason": "no state file at %s" % path, "run_first": "/specd:start"}
    data = load(path)
    current = str(data.get("step", "start"))
    steps = order(data)
    tier = str(data.get("tier", "full"))
    if current not in steps:
        raise ValueError("state.yml has step %r, not in the %s flow" % (current, tier))
    feature = data.get("feature", "")
    if step == "feedback":
        if current == "closed":
            return {"ok": False, "reason": "%s is closed" % feature, "run_first": "/specd:start"}
        if not str(data.get("pr", "")).strip():
            return {"ok": False, "reason": "no PR recorded for %s" % feature,
                    "run_first": "/specd:deliver %s" % feature}
        return {"ok": True, "feature": feature, "step": current, "rerun": False}
    if current == "closed" and step != "close":
        return {"ok": False, "reason": "%s is closed" % feature, "run_first": "/specd:start"}
    if step not in steps:
        out = {"ok": False, "reason": "%s is not in the %s flow" % (step, tier),
               "run_first": "/specd:%s %s" % (current, feature)}
        if tier != "full":
            out["escalate"] = "/specd:start %s --tier %s" % (feature, TIERS[TIERS.index(tier) + 1])
        return out
    cur_i, want_i = steps.index(current), steps.index(step)
    if cur_i < want_i:
        return {"ok": False, "reason": "step is %s, not yet %s" % (current, step),
                "run_first": "/specd:%s %s" % (current, feature)}
    fix = data.get("fix") if isinstance(data.get("fix"), dict) else {}
    if step in ("specify", "implement") and str(fix.get("symptom", "")).strip() \
            and not str(fix.get("reproduced", "")).strip():
        return {"ok": False, "reason": "%s is a fix without a reproduction" % feature,
                "run_first": "/specd:fix %s" % feature}
    needs = []
    if step == "design":
        needs = [("G1", "specify")]
    elif step == "tasks":
        needs = [("G1", "specify")]
        if os.path.isfile(os.path.join(os.path.dirname(os.path.abspath(path)), "design.md")):
            needs.append(("G2", "design"))
    elif step == "implement" and tier != "trivial":
        needs = [("G3", "tasks" if "tasks" in steps else "specify")]
    elif step == "deliver" and current != "deliver":
        before = steps[steps.index("deliver") - 1]
        return {"ok": False, "reason": "step is %s; deliver runs once %s is done" % (current, before),
                "run_first": "/specd:%s %s" % (current, feature)}
    for gate, cmd in needs:
        if not gate_ok(data, gate):
            return {"ok": False, "reason": "%s not approved" % gate,
                    "run_first": "/specd:%s %s" % (cmd, feature)}
    return {"ok": True, "feature": feature, "step": current, "rerun": cur_i > want_i}


def cmd_escalate(argv):
    path, to = opt(argv, "--file"), opt(argv, "--to")
    if not (path and to):
        raise ValueError("escalate needs --file and --to")
    if to not in TIERS:
        raise ValueError("tier must be one of %s" % ", ".join(TIERS))
    if not os.path.isfile(path):
        raise ValueError("no such file: %s" % path)
    data = load(path)
    tier, current = str(data.get("tier", "full")), str(data.get("step", "start"))
    if TIERS.index(to) <= TIERS.index(tier):
        raise ValueError("%s is already %s; escalation only goes up" % (data.get("feature"), tier))
    if current == "closed":
        raise ValueError("%s is closed" % data.get("feature"))
    old, new = order(data), order_for(to, str(data.get("retention", "")))
    if current not in old:
        raise ValueError("state.yml has step %r, not in the %s flow" % (current, tier))
    added = [s for s in new if s not in old and new.index(s) < new.index(current)]
    step = min(added + [current], key=new.index)
    cleared = [STEP_GATE[s] for s in new[new.index(step):] if s in STEP_GATE
               and str(data.get("gates", {}).get(STEP_GATE[s], "")).strip()]
    pairs = [("tier", to), ("step", step),
             ("triage.escalated", "%s->%s at %s" % (tier, to, current))]
    signal = opt(argv, "--signal")
    if signal:
        had = str(data.get("triage", {}).get("signals", "")).strip()
        pairs.append(("triage.signals", "%s,%s" % (had, signal) if had else signal))
    pairs += [("gates.%s" % g, "") for g in cleared]
    changes = patch(path, pairs + [("updated", "now")])
    folder = os.path.dirname(os.path.abspath(path))
    kept = sorted(os.path.basename(p) for p in glob.glob(os.path.join(folder, "*.md")))
    tasks = data.get("tasks") if isinstance(data.get("tasks"), dict) else {}
    return {"file": os.path.abspath(path), "from": tier, "to": to, "at": current, "step": step,
            "cleared": cleared, "kept": kept,
            "tasks_done": sum(1 for v in tasks.values() if v == "done"), "changes": changes}


def spec_roots(root, worktrees):
    """The main spec root, then the spec root of each worktree under WORKTREES."""
    roots = [root]
    if not worktrees or not os.path.isdir(worktrees):
        return roots
    for wt in sorted(glob.glob(os.path.join(os.path.abspath(worktrees), "*", ""))):
        wt = wt.rstrip(os.sep)
        try:
            r = subprocess.run([sys.executable, RESOLVE_PATHS, "--from", wt],
                               capture_output=True, text=True)
            resolved = json.loads(r.stdout) if r.returncode == 0 else None
        except (OSError, ValueError):
            resolved = None
        if resolved and resolved.get("workspace_root") == wt:
            roots.append(resolved["spec_root"])
    return roots


def worktree_root(path):
    """The `.worktrees/<name>` folder holding PATH, or "" when it is not in a worktree."""
    d = os.path.dirname(os.path.abspath(path))
    while True:
        parent = os.path.dirname(d)
        if parent == d:
            return ""
        if os.path.basename(parent) == ".worktrees":
            return d
        d = parent


def features(root, worktrees=None):
    out = []
    for spec_root in spec_roots(root, worktrees):
        for path in sorted(glob.glob(os.path.join(spec_root, "*", "state.yml"))):
            row = {"feature": os.path.basename(os.path.dirname(path)), "path": path,
                   "worktree": worktree_root(path)}
            try:
                data = load(path)
            except ValueError as e:
                row["error"] = str(e)
                out.append(row)
                continue
            data.update(row)
            out.append(data)
    return out


def found(f, by):
    return {"feature": f["feature"], "path": f["path"], "worktree": f.get("worktree", ""), "by": by}


def cmd_find(argv):
    root = opt(argv, "--spec-root")
    if not root:
        raise ValueError("find needs --spec-root")
    name, branch = opt(argv, "--feature"), opt(argv, "--branch")
    worktrees = opt(argv, "--worktrees")
    if name:
        name = name.strip("/").split("/")[-1]
        for spec_root in spec_roots(root, worktrees):
            path = os.path.join(spec_root, name, "state.yml")
            if os.path.isfile(path):
                return found({"feature": name, "path": path, "worktree": worktree_root(path)},
                             "argument")
        raise ValueError("no feature %s under %s" % (name, root))
    all_ = [f for f in features(root, worktrees) if "error" not in f]
    if branch:
        hits = [f for f in all_ if f.get("branch") == branch]
        if len(hits) == 1:
            return found(hits[0], "branch")
    open_ = [f for f in all_ if f.get("step") != "closed"]
    if len(open_) == 1:
        return found(open_[0], "only open")
    names = [f["feature"] + (" (worktree)" if f.get("worktree") else "") for f in open_]
    print(json.dumps({"candidates": names}, indent=2))
    raise ValueError("no feature given and %d open: %s" % (len(names), ", ".join(names) or "none"))


def cmd_list(argv):
    root = opt(argv, "--spec-root")
    if not root:
        raise ValueError("list needs --spec-root")
    out = []
    for f in features(root, opt(argv, "--worktrees")):
        if "error" in f:
            out.append(f)
            continue
        tasks = f.get("tasks") if isinstance(f.get("tasks"), dict) else {}
        counts = {"done": 0, "todo": 0, "skipped": 0}
        for v in tasks.values():
            counts[v if v in counts else "todo"] += 1
        gates = f.get("gates") if isinstance(f.get("gates"), dict) else {}
        review = f.get("review") if isinstance(f.get("review"), dict) else {}
        triage = f.get("triage") if isinstance(f.get("triage"), dict) else {}
        fix = f.get("fix") if isinstance(f.get("fix"), dict) else {}
        step = str(f.get("step", ""))
        try:
            nxt = next_step(f) if step == "start" else step
        except ValueError:
            nxt = step
        if str(fix.get("symptom", "")).strip() and not str(fix.get("reproduced", "")).strip() \
                and step != "closed":
            nxt = "fix"  # the reproduction comes before anything else
        out.append({
            "feature": f["feature"], "tier": f.get("tier", ""), "step": step, "next": nxt,
            "escalated": triage.get("escalated", ""),
            "retention": f.get("retention", ""), "branch": f.get("branch", ""),
            "pr": f.get("pr", ""), "worktree": f.get("worktree", ""),
            "gates": {g: bool(str(gates.get(g, "")).strip()) for g in ("G1", "G2", "G3", "G4", "G5")},
            "tasks": counts,
            "review": {"round": review.get("round", 0), "open": review.get("open", 0)},
            "created": f.get("created", ""), "updated": f.get("updated", ""),
        })
    out.sort(key=lambda x: str(x.get("updated", "")), reverse=True)
    return out


COMMANDS = {"init": cmd_init, "get": cmd_get, "set": cmd_set, "check": cmd_check,
            "escalate": cmd_escalate, "find": cmd_find, "list": cmd_list}


def main(argv):
    if not argv or "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0 if argv else 2
    cmd = argv[0]
    if cmd not in COMMANDS:
        return fail("unknown command %s; one of %s" % (cmd, ", ".join(COMMANDS)))
    try:
        result = COMMANDS[cmd](argv)
    except ValueError as e:
        return fail(str(e))
    except OSError as e:
        return fail(str(e))
    print(json.dumps(result, indent=2))
    if cmd == "check" and not result.get("ok"):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
