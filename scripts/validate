#!/usr/bin/env python3
"""Validate the pacenote plugin against docs/AUTHORING.md. Run from the repo root.

Usage: validate [--help]

Prints one line per check (ok / FAIL) and exits 1 if any check failed. Stdlib only.
"""
import glob
import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SPINE_MAX_LINES = 150
DESCRIPTION_MAX = 1536
CLAUDE_MD_MAX_LINES = 60
MODEL_NAME = re.compile(r"\b(opus|sonnet|haiku)\b|claude-|\bgpt-\d|\bcomposer-\d")
MODEL_NAME_ALLOWED = {"skills/_shared/pacenote-yml.md", "skills/_shared/runtime.md"}
HARDCODED_PATH = re.compile(r"(^|[\s`(\"'])~/|/Users/")
LINK = re.compile(r"\]\(([^)\s#]+)\)")
SEMVER = re.compile(r"^\d+\.\d+\.\d+$")
PLUGIN_ROOT_REF = re.compile(r"\$\{(?:CLAUDE_|CURSOR_)?PLUGIN_ROOT\}/([^\s\"'\\\\]+)")
SCRIPT_REF = re.compile(r"\.\./\.\./scripts/([A-Za-z][\w-]*)")  # skill-relative (paths.md)
PLUGIN_NAME = re.compile(r"^[a-z0-9](?:[a-z0-9]|[.-](?=[a-z0-9]))*$")
# Documented manifest fields (DECISIONS 2026-11-19 M8): key -> allowed JSON types.
STR, OBJ, ARR = (str,), (dict,), (list,)
CODEX_FIELDS = {"name": STR, "version": STR, "description": STR, "author": OBJ, "homepage": STR,
                "repository": STR, "license": STR, "keywords": ARR, "skills": STR,
                "hooks": (str, list, dict), "apps": STR, "interface": OBJ, "onboardingSkill": STR}
CURSOR_FIELDS = {"name": STR, "displayName": STR, "description": STR, "version": STR,
                 "homepage": STR, "repository": STR, "license": STR, "author": OBJ,
                 "keywords": ARR, "logo": STR, "rules": (str, list), "agents": (str, list),
                 "skills": (str, list), "commands": (str, list), "hooks": (str, dict),
                 "mcpServers": (str, dict, list), "variables": OBJ}
HOOK_FILES = {"hooks/hooks.json": "claude", "hooks/codex.json": "codex", "hooks/cursor.json": "cursor"}
READ_ONLY_AGENTS = {"explorer", "researcher", "critic", "analyst", "reviewer", "skill-auditor",
                    "specialist", "runtime-verifier"}  # no file writes and no shell
WRITE_TOOLS = re.compile(r"\b(Write|Edit|MultiEdit|NotebookEdit|Bash)\b")
# Agents that read external content: they may Write (fenced by hooks/source-guard) but get no
# other way to act and no network, and MCP tools only when the tool name is a read verb.
NO_ACT_AGENTS = {"intake", "skill-auditor"}
ACT_TOOLS = re.compile(r"\b(Edit|MultiEdit|NotebookEdit|Bash|WebSearch|WebFetch|Agent|Task)\b")
MCP_READ = re.compile(r"^mcp__\w+?__(get|search|fetch|lookup)\w*$")
GENERATED_CLAUDE_MD = "skills/init/templates/CLAUDE.md"

failures = []


def check(cond, label, detail=""):
    if cond:
        print("ok    %s" % label)
    else:
        print("FAIL  %s%s" % (label, (": " + detail) if detail else ""))
        failures.append(label)


def rel(path):
    return os.path.relpath(path, ROOT)


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def load_json(relpath):
    try:
        return json.loads(read(os.path.join(ROOT, relpath)))
    except (OSError, ValueError) as e:
        check(False, "%s parses" % relpath, str(e))
        return None


def frontmatter(text):
    """Parse a flat YAML frontmatter block. Supports `key: value` and `key: >` / `|` blocks."""
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    data, key = {}, None
    for line in text[4:end].splitlines():
        m = re.match(r"^([A-Za-z][\w-]*):\s*(.*)$", line)
        if m:
            key, value = m.group(1), m.group(2).strip()
            data[key] = "" if value in (">", "|", ">-", "|-") else value.strip("\"'")
        elif key and line.startswith(" "):
            data[key] = (data[key] + " " + line.strip()).strip()
    return data


def check_links(path, text):
    for target in LINK.findall(text):
        if re.match(r"^[a-z]+:", target) or target.startswith("/"):
            continue
        resolved = os.path.normpath(os.path.join(os.path.dirname(path), target))
        check(os.path.exists(resolved), "%s link %s resolves" % (rel(path), target))


def check_text_rules(path, text):
    r = rel(path)
    check(not HARDCODED_PATH.search(text), "%s has no hardcoded home paths" % r)
    if r not in MODEL_NAME_ALLOWED:
        m = MODEL_NAME.search(text)
        check(not m, "%s uses model roles, not names" % r, m.group(0) if m else "")


def is_template(path):
    return "/templates/" in ("/" + rel(path).replace(os.sep, "/"))


def check_manifests():
    plugin = load_json(".claude-plugin/plugin.json")
    market = load_json(".claude-plugin/marketplace.json")
    if not plugin or not market:
        return
    check(plugin.get("name") == "pacenote", "plugin.json name is pacenote")
    check(SEMVER.match(plugin.get("version", "")) is not None, "plugin.json version is semver")
    check(len(plugin.get("description", "")) >= 50, "plugin.json description present")
    check(bool(plugin.get("license")), "plugin.json license present")
    check(bool(plugin.get("author", {}).get("name")), "plugin.json author.name present")
    check(isinstance(plugin.get("repository"), str), "plugin.json repository is a string")
    check(market.get("name") == "pacenote", "marketplace.json name is pacenote")
    check(bool(market.get("owner", {}).get("name")), "marketplace.json owner.name present")
    entries = market.get("plugins", [])
    check(len(entries) == 1 and entries[0].get("name") == "pacenote", "marketplace lists pacenote")
    if entries:
        e = entries[0]
        check(e.get("source") == "./", "marketplace source is ./")
        check(e.get("version") == plugin.get("version"), "marketplace version matches plugin")
        check(e.get("description") == plugin.get("description"),
              "marketplace description matches plugin")
    check_other_manifests(plugin)


def check_fields(relpath, data, fields):
    extra = sorted(k for k in data if k not in fields)
    check(not extra, "%s has documented keys only" % relpath, ", ".join(extra))
    bad = sorted(k for k, v in data.items() if k in fields and not isinstance(v, fields[k]))
    check(not bad, "%s key types match the docs" % relpath, ", ".join(bad))
    check(PLUGIN_NAME.match(str(data.get("name", ""))) is not None, "%s name is kebab-case" % relpath)
    author = data.get("author", {})
    check(isinstance(author, dict) and set(author) <= {"name", "email", "url"},
          "%s author has name/email/url only" % relpath)
    for key in ("hooks", "skills"):
        if isinstance(data.get(key), str):
            check(os.path.exists(os.path.join(ROOT, data[key])), "%s %s path exists" % (relpath, key))


def check_other_manifests(plugin):
    """Codex and Cursor manifests: documented fields, same name and version as Claude's."""
    codex = load_json(".codex-plugin/plugin.json")
    cursor = load_json(".cursor-plugin/plugin.json")
    market = load_json(".cursor-plugin/marketplace.json")
    if not codex or not cursor or not market:
        return
    check_fields(".codex-plugin/plugin.json", codex, CODEX_FIELDS)
    check_fields(".cursor-plugin/plugin.json", cursor, CURSOR_FIELDS)
    check(codex.get("hooks") == "./hooks/codex.json", ".codex-plugin hooks point at hooks/codex.json")
    check(cursor.get("hooks") == "./hooks/cursor.json", ".cursor-plugin hooks point at hooks/cursor.json")
    check(set(market) <= {"name", "owner", "plugins", "metadata"},
          ".cursor-plugin/marketplace.json has documented keys only")
    check(bool(market.get("owner", {}).get("name")), ".cursor-plugin/marketplace.json owner.name present")
    entries = market.get("plugins", [])
    check(len(entries) == 1 and entries[0].get("source") == "./",
          ".cursor-plugin/marketplace.json lists the plugin at ./")
    names = {plugin.get("name"), codex.get("name"), cursor.get("name"), market.get("name")}
    names |= {e.get("name") for e in entries}
    check(names == {"pacenote"}, "all manifests name pacenote", ", ".join(sorted(map(str, names))))
    versions = {plugin.get("version"), codex.get("version"), cursor.get("version")}
    versions |= {e.get("version") for e in entries if "version" in e}
    check(len(versions) == 1, "all manifests carry one version", ", ".join(sorted(map(str, versions))))


def check_script_refs(path, text):
    r = rel(path)
    check("CLAUDE_PLUGIN_ROOT" not in text, "%s names scripts skill-relative" % r)
    for name in sorted(set(SCRIPT_REF.findall(text))):
        check(os.path.isfile(os.path.join(ROOT, "scripts", name)), "%s script %s exists" % (r, name))


def check_skills():
    for d in sorted(glob.glob(os.path.join(ROOT, "skills", "*"))):
        name = os.path.basename(d)
        if name == "_shared":
            check(not os.path.exists(os.path.join(d, "SKILL.md")), "skills/_shared has no SKILL.md")
            continue
        spine = os.path.join(d, "SKILL.md")
        if not os.path.isfile(spine):
            check(False, "skills/%s/SKILL.md exists" % name)
            continue
        text = read(spine)
        fm = frontmatter(text)
        check(fm is not None, "skills/%s frontmatter parses" % name)
        if fm is None:
            continue
        check(fm.get("name") == name, "skills/%s frontmatter name matches folder" % name)
        desc = fm.get("description", "")
        check(bool(desc), "skills/%s description present" % name)
        check(len(desc) <= DESCRIPTION_MAX, "skills/%s description <= %d chars" % (name, DESCRIPTION_MAX),
              str(len(desc)))
        lines = text.count("\n") + (0 if text.endswith("\n") else 1)
        check(lines <= SPINE_MAX_LINES, "skills/%s/SKILL.md <= %d lines" % (name, SPINE_MAX_LINES),
              str(lines))
    for path in sorted(glob.glob(os.path.join(ROOT, "skills", "**", "*.md"), recursive=True)):
        text = read(path)
        if not is_template(path):
            check_links(path, text)
        check_text_rules(path, text)
        check_script_refs(path, text)


def check_agents():
    for path in sorted(glob.glob(os.path.join(ROOT, "agents", "*.md"))):
        name = os.path.splitext(os.path.basename(path))[0]
        text = read(path)
        fm = frontmatter(text)
        check(fm is not None, "agents/%s frontmatter parses" % name)
        if fm is None:
            continue
        check(fm.get("name") == name, "agents/%s frontmatter name matches file" % name)
        check(bool(fm.get("description")), "agents/%s description present" % name)
        tools = fm.get("tools", "")
        check(bool(tools), "agents/%s tools declared" % name)
        check((fm.get("readonly") == "true") == (name in READ_ONLY_AGENTS),
              "agents/%s readonly: true exactly when read-only" % name)
        if name in READ_ONLY_AGENTS:
            m = WRITE_TOOLS.search(tools)
            check(not m, "agents/%s is read-only" % name, m.group(0) if m else "")
        if name in NO_ACT_AGENTS:
            m = ACT_TOOLS.search(tools)
            check(not m, "agents/%s cannot act on what it reads" % name, m.group(0) if m else "")
            bad = [t for t in re.split(r"[,\s]+", tools) if t.startswith("mcp__") and not MCP_READ.match(t)]
            check(not bad, "agents/%s has MCP read tools only" % name, ", ".join(bad))
        check_links(path, text)
        check_text_rules(path, text)
        check_script_refs(path, text)
    gen = subprocess.run([sys.executable, os.path.join(ROOT, "scripts", "codex-agents"), "--check"],
                         capture_output=True, text=True)
    check(gen.returncode == 0, ".codex/agents matches agents/*.md (scripts/codex-agents)",
          gen.stderr.strip().replace("\n", "; "))


def hook_commands(node):
    if isinstance(node, dict):
        for k, v in node.items():
            if k == "command" and isinstance(v, str):
                yield v
            else:
                yield from hook_commands(v)
    elif isinstance(node, list):
        for v in node:
            yield from hook_commands(v)


def check_hooks():
    for relpath, runtime in HOOK_FILES.items():
        if not os.path.exists(os.path.join(ROOT, relpath)):
            check(False, "%s exists" % relpath)
            continue
        data = load_json(relpath)
        if data is None:
            continue
        check(isinstance(data.get("hooks"), dict), "%s has a hooks object" % relpath)
        commands = list(hook_commands(data))
        check(bool(commands), "%s runs commands" % relpath)
        for target in PLUGIN_ROOT_REF.findall(json.dumps(data)):
            check(os.path.exists(os.path.join(ROOT, target)), "%s references %s" % (relpath, target))
        if runtime != "claude":
            wrong = [c for c in commands if "--runtime %s" % runtime not in c]
            check(not wrong, "%s passes --runtime %s" % (relpath, runtime))


def check_scripts():
    paths = glob.glob(os.path.join(ROOT, "scripts", "*")) + glob.glob(os.path.join(ROOT, "hooks", "*"))
    for path in sorted(paths):
        if os.path.isdir(path) or path.endswith((".pyc", ".json")):
            continue
        r = rel(path)
        check(os.access(path, os.X_OK), "%s is executable" % r)
        check(read(path).startswith("#!"), "%s has a shebang" % r)


def check_state_reference():
    path = os.path.join(ROOT, "skills", "_shared", "state-yml.md")
    if os.path.exists(path):
        fences = re.findall(r"```yaml\n(.*?)```", read(path), re.S)
        check(len(fences) == 1, "skills/_shared/state-yml.md has exactly one yaml fence", str(len(fences)))


def check_claude_md():
    for r in ("CLAUDE.md", GENERATED_CLAUDE_MD):
        path = os.path.join(ROOT, r)
        if os.path.exists(path):
            lines = read(path).count("\n")
            check(lines <= CLAUDE_MD_MAX_LINES, "%s <= %d lines" % (r, CLAUDE_MD_MAX_LINES), str(lines))


def check_evals():
    # A case is a folder under evals/ holding prompt.md or case.yaml (docs/AUTHORING.md 13).
    base = os.path.join(ROOT, "evals")
    for d, dirs, files in sorted(os.walk(base)):
        dirs[:] = sorted(x for x in dirs if x not in ("_lib", "results", "mocks"))
        if "prompt.md" not in files and "case.yaml" not in files:
            continue
        dirs[:] = []
        r = rel(d)
        case = read(os.path.join(d, "case.yaml")) if "case.yaml" in files else ""
        name = re.search(r"^name:\s*(\S+)\s*$", case, re.M)
        check(name is not None, "%s case.yaml names the case" % r)
        tags = re.search(r"^tags:\s*\[(.*)\]\s*$", case, re.M)
        kinds = {t.strip() for t in tags.group(1).split(",")} & {"deterministic", "judged"} if tags else set()
        check(len(kinds) == 1, "%s is tagged deterministic or judged" % r)
        graders = glob.glob(os.path.join(d, "graders", "*.md"))
        check(bool(graders), "%s has a grader" % r)
        script = re.search(r"^\s*scaffold_script:\s*(\S+)\s*$", case, re.M)
        if script:
            path = os.path.join(d, script.group(1))
            ok = os.path.exists(path) and os.access(path, os.X_OK)
            check(ok, "%s scaffold is executable" % r)
            if ok:
                check("_lib/workspace.sh" in read(path), "%s scaffold sources _lib/workspace.sh" % r)


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    check_manifests()
    check_skills()
    check_agents()
    check_hooks()
    check_scripts()
    check_state_reference()
    check_claude_md()
    check_evals()
    print("\n%d failure(s)" % len(failures) if failures else "\nall checks passed")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
