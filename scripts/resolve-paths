#!/usr/bin/env python3
"""Resolve specd workspace roots and print them as JSON.

Usage: resolve-paths [--from DIR] [--feature NAME]

Walks upward from DIR (default: current directory) looking for specd.yml
(wrapper mode) or .specd/specd.yml (embedded mode). A feature worktree
(`<wrapper>/.worktrees/<name>/`) is a wrapper layout of its own, so resolving
from inside it returns the worktree's roots; --feature NAME resolves from
`<wrapper>/.worktrees/NAME/` when that worktree exists, else from DIR as usual.
Prints one JSON object with absolute paths: mode, project, workspace_root,
code_root, docs_root, spec_root, config, plus worktree (the worktree root, or ""),
feature (its name, or "") and wrapper_root (the main checkout's workspace root;
equals workspace_root outside a worktree). Exit 1 when no config is found.
Stdlib only.
"""
import json
import os
import re
import sys

DEFAULTS = {
    "embedded": {"code_root": "..", "docs_root": "docs", "spec_root": "spec"},
    "wrapper": {"code_root": None, "docs_root": "docs", "spec_root": "spec"},
}
WORKTREES = ".worktrees"


def find_config(start):
    d = os.path.abspath(start)
    while True:
        for rel in ("specd.yml", os.path.join(".specd", "specd.yml")):
            p = os.path.join(d, rel)
            if os.path.isfile(p):
                return p
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def worktree_of(workspace):
    """(worktree root, feature, wrapper root) for a workspace under .worktrees/, else empties."""
    parent = os.path.dirname(workspace)
    if os.path.basename(parent) == WORKTREES:
        return workspace, os.path.basename(workspace), os.path.dirname(parent)
    return "", "", workspace


def read_keys(path):
    """Return mode, project and paths.* from a flat subset of the YAML."""
    top = {"mode": "embedded", "project": ""}
    paths = {}
    section = None
    with open(path, encoding="utf-8") as f:
        for raw in f:
            line = raw.split("#", 1)[0].rstrip()
            if not line.strip():
                continue
            m = re.match(r"^(\s*)([A-Za-z_][\w]*):\s*(.*)$", line)
            if not m:
                continue
            indent, key, value = len(m.group(1)), m.group(2), m.group(3).strip()
            value = value.strip("\"'")
            if indent == 0:
                section = key
                if key in top:
                    top[key] = value
            elif section == "paths":
                paths[key] = value
    return top, paths


def opt(argv, flag):
    if flag in argv:
        i = argv.index(flag)
        if i + 1 >= len(argv):
            print("resolve-paths: %s needs a value" % flag, file=sys.stderr)
            sys.exit(2)
        return argv[i + 1]
    return None


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    start = opt(argv, "--from") or "."
    feature = opt(argv, "--feature")
    config = find_config(start)
    if not config:
        print("specd: no specd.yml found from %s; run /specd:init" % os.path.abspath(start),
              file=sys.stderr)
        return 1
    if feature:
        _, _, wrapper_root = worktree_of(os.path.dirname(config))
        candidate = os.path.join(wrapper_root, WORKTREES, feature, "specd.yml")
        if os.path.isfile(candidate):
            config = candidate
    top, paths = read_keys(config)
    mode = top["mode"] if top["mode"] in DEFAULTS else "embedded"
    workspace = os.path.dirname(config)
    worktree, wt_feature, wrapper_root = worktree_of(workspace)
    defaults = dict(DEFAULTS[mode])
    if mode == "wrapper":
        defaults["code_root"] = os.path.join(".", top["project"] or ".")
    out = {"mode": mode, "project": top["project"], "workspace_root": workspace}
    for key in ("code_root", "docs_root", "spec_root"):
        rel = paths.get(key) or defaults[key]
        out[key] = os.path.normpath(os.path.join(workspace, rel))
    out["config"] = config
    out["worktree"] = worktree
    out["feature"] = wt_feature
    out["wrapper_root"] = wrapper_root
    print(json.dumps(out, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
