#!/usr/bin/env python3
"""Re-fetch a source snapshot by its origin, diff it, and name the gate to re-open.

Usage: refresh-source --file SNAPSHOT --diff OUT [--new FILE] [--state STATE_YML]

Reads the snapshot's `<!-- specd:source ... -->` header. via="http": re-fetches `origin`
with fetch-source's fetcher. Any other via (mcp:<server>, file): the caller supplies the
new content with --new (a snapshot the intake agent wrote, or the local file); a header in
it is dropped. via="paste": nothing to re-fetch. The new body is redacted and compared with
the old one. Unchanged: nothing is written. Changed: the snapshot is overwritten (captured
bumped, redactions recounted) and a unified diff goes to OUT; the diff is fetched text, so
only the intake agent reads it. Never touches brief.md or spec.md.
With --state, the feature's tier, step and gates decide `reopen` and `rerun`:
quick/full with G1 approved -> G1 / specify; trivial with G4 or G5 approved -> G4 /
implement; otherwise empty with a reason. Prints one JSON object: status (changed |
unchanged | paste | login | thin | error), file, origin, via, added, removed, diff,
redactions, reopen, rerun, reason. Exit 0 unless status is login, thin or error. Stdlib only.
"""
import datetime
import difflib
import importlib.util
import json
import os
import subprocess
import sys
from importlib.machinery import SourceFileLoader

HERE = os.path.dirname(os.path.abspath(__file__))


def load(name):
    loader = SourceFileLoader(name.replace("-", "_"), os.path.join(HERE, name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def split(redact, text):
    """(header attrs or None, body after the header and its note comment)."""
    first, _, rest = text.partition("\n")
    attrs = redact.parse_header(first)
    if attrs is None:
        return None, text
    if rest.startswith("<!--"):
        end = rest.find("-->")
        rest = rest[end + 3:] if end >= 0 else rest
    return attrs, rest.lstrip("\n")


def gate_advice(state_path):
    if not state_path:
        return "", "", "no --state given"
    try:
        out = subprocess.run([os.path.join(HERE, "state"), "get", "--file", state_path],
                             capture_output=True, text=True, check=True).stdout
        data = json.loads(out)
    except (OSError, subprocess.CalledProcessError, ValueError) as e:
        return "", "", "state unreadable: %s" % e
    gates = data.get("gates") or {}
    tier, step = str(data.get("tier", "full")), str(data.get("step", ""))
    if step == "closed":
        return "", "", "feature is closed"
    if tier == "trivial":
        if any(str(gates.get(g, "")).strip() for g in ("G4", "G5")):
            return "G4", "implement", "trivial: the brief is the task and code was approved"
        return "", "", "trivial: implement reads the brief when it runs"
    if str(gates.get("G1", "")).strip():
        return "G1", "specify", "the spec was approved against the old source"
    return "", "", "G1 not approved yet; specify reads the refreshed brief"


def opt(argv, flag, default=None):
    if flag in argv:
        i = argv.index(flag)
        if i + 1 >= len(argv):
            raise ValueError("%s needs a value" % flag)
        return argv[i + 1]
    return default


def main(argv):
    if "--help" in argv or "-h" in argv or not argv:
        print(__doc__.strip())
        return 0 if argv else 2
    try:
        path, diff_out = opt(argv, "--file"), opt(argv, "--diff")
        new_path, state_path = opt(argv, "--new"), opt(argv, "--state")
    except ValueError as e:
        print("specd: %s" % e, file=sys.stderr)
        return 1
    if not path or not diff_out:
        print("specd: --file SNAPSHOT and --diff OUT are required", file=sys.stderr)
        return 1
    redact = load("redact")
    try:
        with open(path, encoding="utf-8") as f:
            old_text = f.read()
    except OSError as e:
        print("specd: %s" % e, file=sys.stderr)
        return 1
    attrs, old_body = split(redact, old_text)
    if attrs is None:
        print("specd: %s has no specd:source header" % path, file=sys.stderr)
        return 1
    via, origin = attrs.get("via", "paste"), attrs.get("origin", "")
    report = {"status": "", "file": os.path.abspath(path), "origin": origin, "via": via,
              "added": 0, "removed": 0, "diff": "", "redactions": int(attrs.get("redactions", 0) or 0),
              "reopen": "", "rerun": "", "reason": ""}
    if new_path:
        try:
            with open(new_path, encoding="utf-8") as f:
                _, new_body = split(redact, f.read())
        except OSError as e:
            report.update(status="error", reason=str(e))
    elif via == "http":
        status, _, new_body, _, reason = load("fetch-source").fetch(origin)
        if status != "ok":
            report.update(status=status, reason=reason)
    elif via == "paste" or not via:
        report.update(status="paste", reason="a paste has no origin to re-fetch; paste the new text")
    else:
        report.update(status="error", reason="via=%s needs --new FILE" % via)
    if report["status"]:
        print(json.dumps(report, indent=2))
        return 0 if report["status"] == "paste" else 1
    new_body, _ = redact.redact(new_body)
    if new_body.strip() == old_body.strip():
        report["status"] = "unchanged"
        print(json.dumps(report, indent=2))
        return 0
    diff = list(difflib.unified_diff(old_body.splitlines(), new_body.splitlines(),
                                     "before", "after", n=2, lineterm=""))
    with open(diff_out, "w", encoding="utf-8") as f:
        f.write("\n".join(diff) + "\n")
    attrs["captured"] = datetime.date.today().isoformat()
    note = old_text.partition("\n")[2]
    note = note[:note.find("-->") + 3] + "\n\n" if note.startswith("<!--") else ""
    text, count, _ = redact.process(redact.render_header(attrs) + "\n" + note + new_body)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    reopen, rerun, reason = gate_advice(state_path)
    report.update(status="changed", diff=os.path.abspath(diff_out), redactions=count,
                  added=sum(1 for l in diff if l.startswith("+") and not l.startswith("+++")),
                  removed=sum(1 for l in diff if l.startswith("-") and not l.startswith("---")),
                  reopen=reopen, rerun=rerun, reason=reason)
    print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
