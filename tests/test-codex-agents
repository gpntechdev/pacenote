#!/usr/bin/env python3
"""Tests for scripts/codex-agents: golden output and the tools -> rules mapping.

Usage: test-codex-agents [--help]   (run from anywhere; stdlib unittest)

tests/fixtures/codex-agents/ holds the expected TOML for three agents that cover each
mapping: explorer (read-only: no shell, no writes, no network), intake (Write only: create
the named files, no shell) and implementer (Bash and edits: no rules but the network one).
After a deliberate change to the generator or to one of those agents, refresh a golden
with `scripts/codex-agents --agent NAME > tests/fixtures/codex-agents/NAME.toml`.
"""
import os
import re
import subprocess
import sys
import tempfile
import unittest

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GEN = os.path.join(ROOT, "scripts", "codex-agents")
GOLDEN = os.path.join(ROOT, "tests", "fixtures", "codex-agents")


def gen(*args):
    return subprocess.run([sys.executable, GEN] + list(args), capture_output=True, text=True)


class CodexAgents(unittest.TestCase):
    def test_golden(self):
        for fn in sorted(os.listdir(GOLDEN)):
            name = os.path.splitext(fn)[0]
            with open(os.path.join(GOLDEN, fn), encoding="utf-8") as f:
                self.assertEqual(gen("--agent", name).stdout, f.read(), name)

    def test_mapping(self):
        explorer = gen("--agent", "explorer").stdout
        self.assertIn("[features]\nshell_tool = false", explorer)
        self.assertIn("Never create, edit or delete files.", explorer)
        self.assertIn("Never fetch anything from the network.", explorer)
        intake = gen("--agent", "intake").stdout
        self.assertIn("Create only the files your prompt names", intake)
        self.assertIn("shell_tool = false", intake)
        impl = gen("--agent", "implementer").stdout
        self.assertNotIn("[features]", impl)
        self.assertNotIn("Never run shell commands.", impl)

    def test_shape(self):
        out = gen("--agent", "critic").stdout
        self.assertTrue(out.startswith("# Generated by scripts/codex-agents from agents/critic.md"))
        for key in ("name", "description", "developer_instructions"):
            self.assertRegex(out, r"(?m)^%s = " % key)
        self.assertNotRegex(out, r"(?m)^(model|tools|maxTurns|readonly)\b")
        body = re.search(r"developer_instructions = '''\n(.*?)'''", out, re.S)
        self.assertIsNotNone(body)

    def test_check_flags_stale_and_extra(self):
        with tempfile.TemporaryDirectory() as d:
            self.assertEqual(gen("--out", d).returncode, 0)
            self.assertEqual(gen("--out", d, "--check").returncode, 0)
            with open(os.path.join(d, "explorer.toml"), "a") as f:
                f.write("# edited\n")
            open(os.path.join(d, "gone.toml"), "w").close()
            res = gen("--out", d, "--check")
            self.assertEqual(res.returncode, 1)
            self.assertIn("stale", res.stderr)
            self.assertIn("extra", res.stderr)

    def test_repo_is_current(self):
        res = gen("--check")
        self.assertEqual(res.returncode, 0, res.stderr)


if __name__ == "__main__":
    if "--help" in sys.argv:
        print(__doc__.strip())
        sys.exit(0)
    unittest.main(verbosity=1)
