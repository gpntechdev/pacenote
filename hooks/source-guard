#!/usr/bin/env python3
"""PreToolUse hook on Read and Write: keep fetched text away from everyone but intake, and
quarantined skills away from everyone but the skill-auditor.

Usage: source-guard [--runtime claude|codex|cursor] [--help]   (reads the hook JSON on stdin)

Claude Code (the default) gets rules 1-4 below. Codex and Cursor send no agent identity
and run no fenced agent (skills/_shared/runtime.md), so there nobody is intake or the
skill-auditor: reads of a fetched snapshot, a refresh diff or anything in `.quarantine/`
are denied whether they come as a file read or as a word of a shell command (pacenote's
own scripts excepted), writes into `.quarantine/` are denied, and a snapshot write that
scripts/redact would change is denied with a pointer to `redact --stdin` (the runtime
cannot rewrite the call). Denials use the runtime's form (hooks/payload).

1. A Write from the `intake` agent (agent_type `intake` or `<plugin>:intake`) is denied
   (exit 2) unless it writes a `sources/<name>.md` snapshot whose content starts with the
   `<!-- pacenote:source ... -->` header.
2. Any Write whose content starts with that header, from any caller, is redacted with
   scripts/redact before it reaches disk: the hook returns `updatedInput` with the
   redacted content and the header's `redactions=` count. If redaction fails, the write
   is denied rather than let through unredacted.
3. A Read, by anyone but the intake agent, of a fetched snapshot (a sources/<name>.md whose
   header says via="http" or via="mcp:...") is denied unless it reads line 1 only
   (limit 1, no offset past it); a Read of a refresh diff (*.diff under spec/ or sources/
   named source-refresh-* or .refresh-*) is denied outright. Fetched text reaches the main
   thread only as the intake agent's summary. Bash and Grep are not inspected.
4. A Read of a file under a `.quarantine/` folder (third-party skill candidates fetched
   by scripts/skill-fetch) is denied to everyone but the `skill-auditor` agent, and the
   skill-auditor may Read nothing outside it. A Write into `.quarantine/` is denied to
   everyone: only the scripts fill it. Quarantined text reaches the main thread only as
   the auditor's answer and audit-static's escaped findings.
Anything else, including unreadable input, exits 0. Stdlib only.
"""
import importlib.util
import json
import os
import re
import sys
from importlib.machinery import SourceFileLoader

SCRIPTS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts")
HEADER = "<!-- pacenote:source "
SNAPSHOT = re.compile(r"(^|/)sources/[^/]+\.md$")
DIFF = re.compile(r"(^|/)(source-refresh-[^/]*|\.refresh-[^/]*)\.diff$")
FETCHED = re.compile(r'^<!-- pacenote:source .*\bvia="(http|mcp:[^"]*)"')
QUARANTINE = re.compile(r"(^|/)\.quarantine(/|$)")


def deny(msg):
    print("pacenote source-guard: %s" % msg, file=sys.stderr)
    return 2


def load_redact():
    loader = SourceFileLoader("redact", os.path.join(SCRIPTS, "redact"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def check_read(path, tool_input):
    if DIFF.search(path):
        return deny("%s is a refresh diff of fetched text; only the intake agent reads it" % path)
    if not SNAPSHOT.search(path):
        return 0
    try:
        with open(path, encoding="utf-8") as f:
            first = f.readline()
    except OSError:
        return 0
    if not FETCHED.match(first):
        return 0
    limit, offset = tool_input.get("limit"), tool_input.get("offset") or 0
    try:
        header_only = limit is not None and int(limit) <= 1 and int(offset) <= 1
    except (TypeError, ValueError):
        header_only = False
    if header_only:
        return 0
    return deny("%s is a fetched snapshot: read line 1 only (limit 1) for its header; its "
                "content reaches you through the intake agent's answer" % path)


def load_payload():
    loader = SourceFileLoader("pacenote_payload", os.path.join(os.path.dirname(
        os.path.abspath(__file__)), "payload"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def fetched(path, cwd):
    full = path if os.path.isabs(path) or not cwd else os.path.join(cwd, path)
    if not SNAPSHOT.search(path.replace("\\", "/")):
        return False
    try:
        with open(full, encoding="utf-8") as f:
            return bool(FETCHED.match(f.readline()))
    except OSError:
        return False


def guarded_read(path, cwd):
    """Why a read of path is refused off Claude Code, or None."""
    norm = path.replace("\\", "/")
    if QUARANTINE.search(norm):
        return "%s is a quarantined skill candidate; this runtime runs no skill-auditor" % path
    if DIFF.search(norm):
        return "%s is a refresh diff of fetched text; only the intake agent reads it" % path
    if fetched(norm, cwd):
        return ("%s is a fetched snapshot; this runtime cannot fence the intake agent, so "
                "paste the source instead" % path)
    return None


def other_runtime(runtime, data):
    payload = load_payload()
    ev = payload.normalise(data, runtime)
    for path in ev["reads"]:
        why = guarded_read(path, ev["cwd"])
        if why:
            return payload.deny(runtime, "pacenote source-guard: " + why)
    words = payload.shell_tokens(ev["shell"]) if ev["shell"] else []
    if words and os.path.dirname(os.path.abspath(words[0])) != SCRIPTS:
        for word in words:
            why = guarded_read(word, ev["cwd"])
            if why:
                return payload.deny(runtime, "pacenote source-guard: " + why)
    for path, content in ev["writes"]:
        if QUARANTINE.search(path.replace("\\", "/")):
            return payload.deny(runtime, "pacenote source-guard: nothing writes into "
                                ".quarantine/ but scripts/skill-fetch; refused %s" % path)
        if isinstance(content, str) and content.startswith(HEADER):
            try:
                text, count, _ = load_redact().process(content)
            except Exception as e:  # fail closed: never write a snapshot unredacted
                return payload.deny(runtime, "pacenote source-guard: redaction failed (%s); "
                                    "snapshot not written" % e)
            if text != content:
                return payload.deny(runtime, "pacenote source-guard: %s holds %d secret-looking "
                                    "string(s); write the text that `scripts/redact --stdin` "
                                    "prints instead" % (path, count))
    return 0


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    runtime = load_payload().runtime_arg(argv)
    if runtime != "claude":
        try:
            data = json.load(sys.stdin)
        except ValueError:
            return 0
        return other_runtime(runtime, data) if isinstance(data, dict) else 0
    try:
        data = json.load(sys.stdin)
        tool_input = data.get("tool_input") or {}
    except (ValueError, AttributeError):
        return 0
    if not isinstance(tool_input, dict):
        return 0
    path = str(tool_input.get("file_path", "")).replace("\\", "/")
    agent = str(data.get("agent_type") or "")
    intake = agent == "intake" or agent.endswith(":intake")
    auditor = agent == "skill-auditor" or agent.endswith(":skill-auditor")
    quarantined = bool(QUARANTINE.search(path))
    if data.get("tool_name") == "Read":
        if auditor:
            return 0 if quarantined else deny("the skill-auditor reads only the quarantine "
                                              "folder it was given; refused %s" % path)
        if quarantined:
            return deny("%s is a quarantined skill candidate; its content reaches you only "
                        "through the skill-auditor agent and audit-static" % path)
        return 0 if intake else check_read(path, tool_input)
    if data.get("tool_name") != "Write":
        return 0
    if quarantined or auditor:
        return deny("nothing writes into .quarantine/ but scripts/skill-fetch; refused %s"
                    % (path or "a write without a path"))
    content = tool_input.get("content")
    content = content if isinstance(content, str) else ""
    is_snapshot = content.startswith(HEADER)
    if intake:
        if not SNAPSHOT.search(path) or not is_snapshot:
            return deny("the intake agent may only write sources/<name>.md snapshots with "
                        "a pacenote:source header; refused %s" % (path or "a write without a path"))
    if not is_snapshot:
        return 0
    try:
        text, _, _ = load_redact().process(content)
    except Exception as e:  # fail closed: never write a snapshot unredacted
        return deny("redaction failed (%s); snapshot not written" % e)
    updated = dict(tool_input, content=text)
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                             "updatedInput": updated}}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
