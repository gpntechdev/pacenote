#!/usr/bin/env python3
"""Hook: deny reads and edits of secret-looking files, in Claude Code, Codex and Cursor.

Usage: secrets-guard [--runtime claude|codex|cursor] [--help]   (hook JSON on stdin)

hooks/payload turns the runtime's payload into paths (Claude Read/Edit/Write/MultiEdit/
NotebookEdit, Codex apply_patch, Cursor beforeReadFile and preToolUse Write/Delete) and
shell commands (Codex Bash, Cursor beforeShellExecution and preToolUse Shell, where a
read goes through `cat`, `sed`, `source`...). Each path and each word of a command is
matched against a fixed list of secret file patterns. On a match the call is blocked in
the runtime's form: exit 2 with a one-line reason on stderr, and for Cursor also
{"permission": "deny"} on stdout. Anything else, including unreadable input, passes
silently. --runtime defaults to claude. Stdlib only.
"""
import fnmatch
import json
import os
import sys
from importlib.machinery import SourceFileLoader
import importlib.util


def load_payload():
    loader = SourceFileLoader("pacenote_payload", os.path.join(os.path.dirname(
        os.path.abspath(__file__)), "payload"))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


ALLOW = {".env.example", ".env.sample", ".env.template", ".env.dist"}
BASENAMES = [".env", ".env.*", "*.pem", "*.key", "*.p12", "*.pfx", "id_rsa*", "id_ed25519*",
             "id_ecdsa*", ".netrc", ".git-credentials", "credentials.json", "service-account*.json",
             "*.credentials"]
PATH_SUFFIXES = [".aws/credentials", ".kube/config"]


def is_secret(path):
    norm = path.replace("\\", "/")
    base = norm.rsplit("/", 1)[-1]
    if base in ALLOW:
        return False
    if any(fnmatch.fnmatch(base, p) for p in BASENAMES):
        return True
    return any(norm == s or norm.endswith("/" + s) for s in PATH_SUFFIXES)


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    payload = load_payload()
    runtime = payload.runtime_arg(argv)
    try:
        data = json.load(sys.stdin)
        if not isinstance(data, dict):
            return 0
        ev = payload.normalise(data, runtime)
    except (ValueError, AttributeError):
        return 0
    paths = ev["reads"] + [w[0] for w in ev["writes"]]
    for path in paths:
        if is_secret(path):
            return payload.deny(runtime, "pacenote: refusing to %s %s: secret-looking file; read "
                                "it yourself outside the assistant if needed" % (ev["tool"], path))
    for word in payload.shell_tokens(ev["shell"]) if ev["shell"] else []:
        if is_secret(word):
            return payload.deny(runtime, "pacenote: refusing a command that names %s: "
                                "secret-looking file; read it yourself outside the assistant "
                                "if needed" % word)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
