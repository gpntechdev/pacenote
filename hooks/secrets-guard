#!/usr/bin/env python3
"""PreToolUse hook: deny Read, Edit, Write, MultiEdit and NotebookEdit on secret-looking files.

Usage: secrets-guard [--help]   (reads the hook JSON on stdin)

Collects tool_input.file_path, tool_input.notebook_path and tool_input.file_edits[].file_path,
matches each against a fixed list of secret file patterns, and exits 2 with a one-line reason
on a match, which blocks the tool call. Anything else, including unreadable input, exits 0.
Stdlib only.
"""
import fnmatch
import json
import sys

ALLOW = {".env.example", ".env.sample", ".env.template", ".env.dist"}
BASENAMES = [".env", ".env.*", "*.pem", "*.key", "*.p12", "*.pfx", "id_rsa*", "id_ed25519*",
             "id_ecdsa*", ".netrc", ".git-credentials", "credentials.json", "service-account*.json",
             "*.credentials"]
PATH_SUFFIXES = [".aws/credentials", ".kube/config"]


def is_secret(path):
    norm = path.replace("\\", "/")
    base = norm.rsplit("/", 1)[-1]
    if base in ALLOW:
        return False
    if any(fnmatch.fnmatch(base, p) for p in BASENAMES):
        return True
    return any(norm == s or norm.endswith("/" + s) for s in PATH_SUFFIXES)


def paths_from(tool_input):
    out = []
    for key in ("file_path", "notebook_path"):
        v = tool_input.get(key)
        if isinstance(v, str):
            out.append(v)
    for edit in tool_input.get("file_edits") or []:
        if isinstance(edit, dict) and isinstance(edit.get("file_path"), str):
            out.append(edit["file_path"])
    return out


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    try:
        data = json.load(sys.stdin)
        tool = data.get("tool_name", "tool")
        tool_input = data.get("tool_input") or {}
        if not isinstance(tool_input, dict):
            return 0
    except (ValueError, AttributeError):
        return 0
    for path in paths_from(tool_input):
        if is_secret(path):
            print("pacenote: refusing to %s %s: secret-looking file; read it yourself outside the "
                  "assistant if needed" % (tool, path), file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
